+
+/// M895 scratch measurement for PR #895's design: never lands.
+pub fn m895_probe(test_config: &Path) -> Result<(), String> {
+    let qemu = QemuInstance::boot_with_options(
+        test_config,
+        &[],
+        &[],
+        BootOptions { profile: Profile::HeadlessVirtioGpu, ..Default::default() },
+    );
+    let log = Serial::boot(&qemu);
+    let lines: Vec<&str> =
+        log.text().lines().filter(|l| l.contains("M895") || l.contains("VirtIO GPU") || l.contains("VirtIO: PCI")).collect();
+    Err(format!("M895 measurement, not a test:\n{}", lines.join("\n")))
+}
