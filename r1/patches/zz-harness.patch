+    let mut failed = String::new();
+    for job in ["test_rs_mmap_stress", "test_rs_zz_touch_scratch"] {
+        let result = qemu.run_test(job, Duration::from_secs(600));
+        eprintln!("ZZ {job} exit={:?} error={:?}\n{}", result.exit_code, result.error, result.stdout);
+        if result.exit_code != Some(0) { failed += job; }
+    }
+    if failed.is_empty() { Ok(()) } else { Err(failed) }
