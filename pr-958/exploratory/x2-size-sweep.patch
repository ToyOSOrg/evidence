+/// Exploratory: seal at sizes around the short paths' thresholds, to fit
+/// fixed per-message cost against per-block cost. Not committed.
+fn sweep_rows(alg: Tls, rows: &mut Vec<Box<dyn Row>>) {
+    let name = alg.name();
+    for len in [1usize, 16, 32, 48, 63, 65, 128, 129, 192, 193] {
+        seals_as_ring(alg, len);
+        let mut key = alg.sealing();
+        let mut buf = vec![0x70; len];
+        rows.push(trio(
+            format!("{name}/sweep/{len}"),
+            move || keep(key.seal(&AAD, &mut buf).expect("seal")),
+            move || {
+                let (key, mut buf, mut sequence) = (alg.ring(), vec![0x70; len], 0);
+                move || {
+                    let tag = key.seal_in_place_separate_tag(nonce(sequence), aead::Aad::from(AAD), &mut buf);
+                    keep(tag.expect("seal"));
+                    sequence += 1;
+                }
+            },
+        ));
+    }
+}
