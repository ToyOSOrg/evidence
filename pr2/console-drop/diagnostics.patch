+// DIAG (temporary): every 3 s, tee every committed record since the last tee
+// straight to the 16550, and say whether the wire owes records.
+static DIAG_NEXT: AtomicU64 = AtomicU64::new(0);
+static DIAG_FROM: AtomicU64 = AtomicU64::new(0);
+pub fn diag_tee(now_ns: u64) {
+    let next = DIAG_NEXT.load(Ordering::Relaxed);
+    if now_ns < next || now_ns < 20_000_000_000 {
+        return;
+    }
+    if DIAG_NEXT.compare_exchange(next, now_ns + 3_000_000_000, Ordering::AcqRel, Ordering::Relaxed).is_err() {
+        return;
+    }
+    let to = super::read::newest_committed();
+    let from = DIAG_FROM.load(Ordering::Relaxed);
+    let mut uart = serial::panic_registers();
+    uart.write(b"[diag] pending=");
+    uart.write(if DRAINED.any_pending() { b"y" } else { b"n" });
+    uart.write(b" queue=");
+    uart.hex(QUEUE.try_lock().map_or(u64::MAX, |q| q.len as u64));
+    uart.write(b" now=");
+    uart.hex(now_ns);
+    uart.write(b"\n");
+    let mut sink = Raw { uart: &mut uart };
+    super::read::snapshot_committed(super::LogStamp::since_zero(from), to, &mut sink);
+    DIAG_FROM.store(to.nanos().saturating_add(1), Ordering::Relaxed);
+}
