+/// Measurement only, never lands: `osbench ipcsplit` decodes these codes.
+#[cfg(feature = "scout-ipc-marks")]
+pub mod scout {
+    pub const SYS_ENTER: u32 = 1;
+    pub const SYS_EXIT: u32 = 2;
+    pub const KICK_BEGIN: u32 = 3;
+    pub const KICK_END: u32 = 4;
+    pub const RESUMED: u32 = 8;
+    pub const RESOLVED: u32 = 10;
+    pub const QUEUED: u32 = 11;
+    pub const POSTED: u32 = 12;
+    pub const TAKEN: u32 = 13;
+    pub const RECV_DONE: u32 = 14;
+    pub const PARKING: u32 = 15;
+    pub const DELIVERED: u32 = 17;
+
+    #[inline]
+    pub fn mark(code: u32, arg: u32) {
+        super::trace(super::Kind::Mark, code << 24 | (arg & 0x00FF_FFFF));
+    }
+
+    pub fn marked(num: u64) -> bool {
+        use toyos_abi::syscall::*;
+        matches!(num, SYS_MESSAGE_SEND | SYS_MESSAGE_RECV | SYS_MESSAGE_CALL | SYS_INBOX_SUBMIT)
+    }
+}
