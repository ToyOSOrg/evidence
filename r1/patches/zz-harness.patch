+fn zz_scratch_mem(test_config: &Path, arch: toyos_build::arch::Arch, profile: qemu::Profile) -> Result<(), String> {
+    let tests = compile::repo_root().join("tests/guest/rust-tests");
+    let bins: Vec<(String, Vec<u8>)> = ["mmap_stress", "zz_touch_scratch"].iter().map(|n| (n.to_string(), qemu::build_toyos_bin(arch, &tests, n))).collect();
