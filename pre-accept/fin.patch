+    /// Measurement only, PR #863: the FIN remembered past a hole, as a copy at the accept that
+    /// carries no FIN leaves the region.
+    pub fn lose_fin(&mut self) {
+        self.fin = None;
+    }
+
     fn offset(&self, seq: Seq) -> usize {
         usize::try_from(seq.since(self.next)).unwrap_or(usize::MAX).saturating_add(self.buf.len())
     }
