+/// PROBE, never lands: per pid and syscall number, the deepest byte below the
+/// stack top the syscall wrote, found by painting the stack below the handler.
+pub mod depth_census {
+    use core::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+    const PIDS: usize = 128;
+    const NUMS: usize = 130;
+    const PAINT: u64 = 16 * 1024;
+    const BYTE: u8 = 0x5A;
+
+    static DEEPEST: [[AtomicU64; NUMS]; PIDS] = [const { [const { AtomicU64::new(0) }; NUMS] }; PIDS];
+    static SHALLOWEST: [[AtomicU64; NUMS]; PIDS] = [const { [const { AtomicU64::new(u64::MAX) }; NUMS] }; PIDS];
+    static CALLS: [[AtomicU64; NUMS]; PIDS] = [const { [const { AtomicU64::new(0) }; NUMS] }; PIDS];
+
+    pub struct Painted { top: u64, low: u64, high: u64, pid: usize }
+
+    #[inline(never)]
+    pub fn paint() -> Option<Painted> {
+        let pid = super::percpu::current_pid()?.raw() as usize;
+        if pid >= PIDS { return None; }
+        let top = super::percpu::gs::read_u64::<{ super::percpu::OFF_KERNEL_RSP }>();
+        let rsp: u64;
+        unsafe { core::arch::asm!("mov {}, rsp", out(reg) rsp, options(nomem, nostack, preserves_flags)) };
+        let low = top - PAINT;
+        let high = rsp - 1024;
+        unsafe { core::ptr::write_bytes(low as *mut u8, BYTE, (high - low) as usize) };
+        Some(Painted { top, low, high, pid })
+    }
+
+    #[inline(never)]
+    pub fn read(p: Option<Painted>, num: u64) {
+        let Some(p) = p else { return };
+        let num = num as usize;
+        if num >= NUMS { return; }
+        let mut at = p.low;
+        while at < p.high && unsafe { core::ptr::read_volatile(at as *const u8) } == BYTE {
+            at += 1;
+        }
+        let depth = p.top - at;
+        DEEPEST[p.pid][num].fetch_max(depth, Relaxed);
+        SHALLOWEST[p.pid][num].fetch_min(depth, Relaxed);
+        CALLS[p.pid][num].fetch_add(1, Relaxed);
+    }
+
+    pub fn line(pid: u32) -> alloc::string::String {
+        use core::fmt::Write;
+        let mut s = alloc::string::String::from("depth-census(num:calls:shallowest..deepest):");
+        let Some(row) = DEEPEST.get(pid as usize) else { return s };
+        for (num, d) in row.iter().enumerate() {
+            let calls = CALLS[pid as usize][num].load(Relaxed);
+            if calls != 0 {
+                let _ = write!(s, " {num}:{calls}:{}..{}", SHALLOWEST[pid as usize][num].load(Relaxed), d.load(Relaxed));
+            }
+        }
+        s
+    }
+}
