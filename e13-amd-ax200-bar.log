$ cat e13.sh
#!/bin/bash
# E13: the AX200's BAR on the AMD bench and the bridge in front of it.
# 1. As main's kernel logged them on the AMD bench: #884's metal run at
#    f2c537a51, metal/head-amd-kernel.log on ToyOSOrg/evidence pr-884 at
#    7b6ac575cf12e4afb2adda3bd2ec80d76896a06f, already masked there: the AX200's
#    function, the bridge forwarding to its bus, the root bridge windows and the
#    free runs placement offers candidates from.
# 2. What the Wi-Fi demo's run logged of placing that BAR, as its commit
#    messages record it: E10 line 42's tip, and the one commit under E10 line
#    44's tip whose subject opens "<bench> image v11: the AX200's BAR 0". The
#    bench's model name is masked in every case; no commit is named by hash.
# argv: <evidence clone> <worktree> <word to mask> <E10's log>
set -u
ev=$1 repo=$2 mask=$3 e10=$4
[ -r "$e10" ] || exit 3
ci=$(echo "$mask" | awk '{ s=""; for (i=1;i<=length($0);i++) { c=substr($0,i,1); s=s "[" tolower(c) toupper(c) "]" } print s }')
m() { sed "s/$ci/<bench>/g"; }
echo "## 1. main's kernel on the AMD bench"
echo "\$ git -C <evidence> show 7b6ac575cf12e4afb2adda3bd2ec80d76896a06f:metal/head-amd-kernel.log | sed -n '65p;79p;90,101p'"
git -C "$ev" show 7b6ac575cf12e4afb2adda3bd2ec80d76896a06f:metal/head-amd-kernel.log | sed -n '65p;79p;90,101p' | m
echo "exit ${PIPESTATUS[0]}"
echo
echo "## 2. the demo's commit messages"
cd "$repo" || exit 2
t42=$(sed -n '42p' "$e10" | awk '{print $2}' | tr -d ':')
t44=$(sed -n '44p' "$e10" | awk '{print $2}' | tr -d ':')
echo "\$ git log -1 --format='%s%n%n%b' <E10 line 42's tip> | sed -n '1,12p'"
git log -1 --format='%s%n%n%b' "$t42" | sed -n '1,12p' | m
echo "exit ${PIPESTATUS[0]}"
v11=$(git log --format=%H --grep="^$ci image v11: the AX200's BAR 0" "origin/main..$t44")
echo "\$ git log --format=%H --grep=\"^<bench> image v11: the AX200's BAR 0\" origin/main..<E10 line 44's tip> | wc -l"
n=$(echo "$v11" | grep -c .); echo "$n"
[ "$n" -eq 1 ] || exit 4
echo "\$ git log -1 --format='%s%n%n%b' <that commit> | sed -n '1,12p'"
git log -1 --format='%s%n%n%b' "$v11" | sed -n '1,12p' | m
echo "exit ${PIPESTATUS[0]}"

$ bash e13.sh <evidence clone> <the wifi worktree> <the bench word> <E10, e10-demo-branches-on-origin.log at pr-876 5d27b8209199>
