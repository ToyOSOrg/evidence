$ cat e15.sh
#!/bin/bash
# E15: every commit of the Wi-Fi demo that no branch on origin holds, and
# whether any ref on origin holds it (pull requests' refs included), so that
# GitHub's garbage collection is what the demo issue's exit waits for.
# 1. git rev-list <E10's 12 tips past wt/toyos-survey> --not --remotes=origin:
#    its count.
# 2. The same commits less every commit any ref on origin holds, every ref
#    `git ls-remote origin` lists: its count.
# 3. The repository's forks, which share its objects on GitHub.
# 4. Each of those commits asked of GitHub's commit API for origin: how many
#    resolve.
# No commit is printed and no message is read.
# argv: <worktree> <scratch dir> <E10's log>
set -u
repo=$1 scratch=$2 e10=$3
[ -r "$e10" ] || exit 3
cd "$repo" || exit 2
echo "\$ git fetch origin"; git fetch origin > "$scratch/fetch" 2>&1; echo "exit $?"
echo "\$ git rev-parse origin/main"; git rev-parse origin/main
tips=$(sed -n '41,52p' "$e10" | awk '{print $2}' | tr -d ':')
echo "tips read from E10 lines 41 to 52: $(echo "$tips" | grep -c .)"
for t in $tips; do git cat-file -e "$t^{commit}" || exit 4; done
echo "## 1."
echo "\$ git rev-list <the 12 tips> --not --remotes=origin | wc -l"
git rev-list $tips --not --remotes=origin > "$scratch/demo"; e=$?
echo "exit $e, $(grep -c . "$scratch/demo") commits"
echo "## 2."
echo "\$ git ls-remote origin"; git ls-remote origin > "$scratch/refs"; echo "exit $?, $(grep -c . "$scratch/refs") refs, $(grep -c 'refs/pull/' "$scratch/refs") of them pull requests' refs"
missing=0
while read -r sha ref; do
  git cat-file -e "$sha" 2>/dev/null || git fetch -q origin "$ref" 2>/dev/null
  git cat-file -e "$sha" 2>/dev/null || missing=$((missing+1))
done < "$scratch/refs"
echo "refs whose object is not held locally after a fetch of it: $missing"
awk '{print "^" $1}' "$scratch/refs" | sort -u > "$scratch/shas"
echo "\$ git rev-list <the 12 tips> --stdin < <'^' and each object ls-remote lists, one a line> | wc -l"
git rev-list $tips --stdin < "$scratch/shas" > "$scratch/unheld"; e=$?
echo "exit $e, $(grep -c . "$scratch/unheld") commits"
echo "of section 1's commits, held by some ref on origin: $(comm -23 <(sort "$scratch/demo") <(sort "$scratch/unheld") | grep -c .)"
echo "## 3."
echo "\$ gh api repos/ToyOSOrg/ToyOS --jq .forks_count"; gh api repos/ToyOSOrg/ToyOS --jq .forks_count; echo "exit $?"
echo "## 4."
resolving=0 notfound=0 other=0
while read -r c; do
  gh api "repos/ToyOSOrg/ToyOS/commits/$c" > /dev/null 2> "$scratch/err"; e=$?
  if [ "$e" -eq 0 ]; then resolving=$((resolving+1))
  elif grep -q 'HTTP 404\|HTTP 422' "$scratch/err"; then notfound=$((notfound+1))
  else other=$((other+1)); fi
done < "$scratch/demo"
echo "of section 1's commits: $resolving resolve on origin (exit 0), $notfound answered 404 or 422, $other other failures"
rm -f "$scratch/demo" "$scratch/unheld" "$scratch/shas" "$scratch/refs" "$scratch/err" "$scratch/fetch"

$ bash e15.sh <the wifi worktree> <scratch dir> <E10, e10-demo-branches-on-origin.log at pr-876 5d27b8209199>
$ git fetch origin
exit 0
$ git rev-parse origin/main
97f07c381d8f14811046d65dda9eed5a21a35cd9
tips read from E10 lines 41 to 52: 12
## 1.
$ git rev-list <the 12 tips> --not --remotes=origin | wc -l
exit 0, 52 commits
## 2.
$ git ls-remote origin
exit 0, 1132 refs, 916 of them pull requests' refs
refs whose object is not held locally after a fetch of it: 0
$ git rev-list <the 12 tips> --stdin < <'^' and each object ls-remote lists, one a line> | wc -l
exit 0, 52 commits
of section 1's commits, held by some ref on origin: 0
## 3.
$ gh api repos/ToyOSOrg/ToyOS --jq .forks_count
0
exit 0
## 4.
of section 1's commits: 52 resolve on origin (exit 0), 0 answered 404 or 422, 0 other failures
EXIT=0
