# Rosetta 2 ADX reproduction, development Mac (Apple M4 Pro), macOS 27.0.1 build 26A434, rustc 1.98.1 (48a229cea 2026-09-01)
## source: src/bin/ill.rs
fn main() {
    let which = std::env::args().nth(1).unwrap();
    let mut x: u64 = 3;
    let mut y: u64 = 5;
    unsafe {
        match which.as_str() {
            "mulx" => core::arch::asm!("mov rdx, {0}", "mulx {1}, {0}, {1}", inout(reg) x, inout(reg) y, out("rdx") _),
            "adcx" => core::arch::asm!("adcx {0}, {1}", inout(reg) x, in(reg) y),
            "adox" => core::arch::asm!("adox {0}, {1}", inout(reg) x, in(reg) y),
            _ => {}
        }
    }
    println!("{which} ok {x} {y}");
}
## cargo build --release --target x86_64-apple-darwin --bin ill
build exit 0
## CPUID as a translated process sees it (std::is_x86_feature_detected!, from probe-test, built for x86_64-apple-darwin)
bmi2 true adx true
mulx ok 15 0
ill mulx: exit 0
ill adcx: exit 132
ill adox: exit 132
## 132 = 128 + 4 (SIGILL)
