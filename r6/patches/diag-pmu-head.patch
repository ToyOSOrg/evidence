+/// Measurement only, never lands: the core's counters around each walk's copy
+/// phase, programmed once per CPU beside the hard-lockup watchdog's fixed
+/// counter 2 (`arch::pmu`), which keeps its bits.
+///
+/// Programming per Intel SDM Vol. 3B §20.2.2 (architectural performance
+/// monitoring version 2+: `IA32_PERFEVTSELx` 0x186+ with event in bits 7:0,
+/// umask 15:8, OS bit 17, EN bit 22; `IA32_FIXED_CTR_CTRL` 0x38D, a nibble
+/// per fixed counter, bit 0 of each enabling ring 0; `IA32_PERF_GLOBAL_CTRL`
+/// 0x38F, PMCs in bits 3:0 and fixed counters from bit 32) and §20.2.1.1
+/// (RDPMC, bit 30 of ECX selecting a fixed counter). Event codes from Intel's
+/// Tiger Lake core event table (perfmon `TGL/events/tigerlake_core.json`):
+/// fixed 0 `INST_RETIRED.ANY`, fixed 1 `CPU_CLK_UNHALTED.THREAD`, PMC0
+/// `LD_BLOCKS_PARTIAL.ADDRESS_ALIAS` (0x07/0x01), PMC1 `L1D.REPLACEMENT`
+/// (0x51/0x01), PMC2 `L2_RQSTS.MISS` (0x24/0x3F), PMC3 `RESOURCE_STALLS.SB`
+/// (0xA2/0x08).
+mod pmu_diag {
+    use core::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+    static PROGRAMMED: AtomicU64 = AtomicU64::new(0);
+    pub static TOTALS: [AtomicU64; 6] = [const { AtomicU64::new(0) }; 6];
+
+    const EVENTS: [u64; 4] = [0x07 | 0x01 << 8, 0x51 | 0x01 << 8, 0x24 | 0x3F << 8, 0xA2 | 0x08 << 8];
+
+    fn ready() {
+        let cpu = crate::arch::percpu::cpu_id();
+        let bit = 1u64 << (cpu % 64);
+        if PROGRAMMED.load(Relaxed) & bit != 0 {
+            return;
+        }
+        for (i, event) in EVENTS.iter().enumerate() {
+            // SAFETY: an architectural PMU MSR, written with what §20.2.2 defines.
+            unsafe { crate::arch::cpu::wrmsr(0x186 + i as u32, event | 1 << 17 | 1 << 22) };
+        }
+        let fixed = crate::arch::cpu::rdmsr(0x38D) | 0x11;
+        let global = crate::arch::cpu::rdmsr(0x38F) | 0xF | 1 << 32 | 1 << 33;
+        // SAFETY: as above; the watchdog's bits are kept.
+        unsafe {
+            crate::arch::cpu::wrmsr(0x38D, fixed);
+            crate::arch::cpu::wrmsr(0x38F, global);
+        }
+        PROGRAMMED.fetch_or(bit, Relaxed);
+    }
+
+    fn rdpmc(ecx: u32) -> u64 {
+        let (lo, hi): (u32, u32);
+        // SAFETY: reads a counter `ready` enabled; ring 0 may always.
+        unsafe { core::arch::asm!("rdpmc", in("ecx") ecx, out("eax") lo, out("edx") hi, options(nomem, nostack)) };
+        u64::from(hi) << 32 | u64::from(lo)
+    }
+
+    pub fn read() -> [u64; 6] {
+        ready();
+        [rdpmc(1 << 30), rdpmc(1 << 30 | 1), rdpmc(0), rdpmc(1), rdpmc(2), rdpmc(3)]
+    }
+
+    pub fn add(before: [u64; 6], after: [u64; 6]) {
+        for i in 0..6 {
+            TOTALS[i].fetch_add(after[i].wrapping_sub(before[i]) & ((1 << 48) - 1), Relaxed);
+        }
+    }
+
+    pub fn totals() -> [u64; 6] {
+        core::array::from_fn(|i| TOTALS[i].load(Relaxed))
+    }
+}
+
+pub fn pmu_totals() -> [u64; 6] {
+    pmu_diag::totals()
+}
