+fn scratch_entry_jobs(test_config: &Path) -> Result<(), String> {
+    let root = compile::repo_root().join("tests/guest/rust-tests");
+    let jobs = ["first_entry", "ring0_clears_ac"];
+    let bins: Vec<(String, Vec<u8>)> = jobs.iter().map(|j| (j.to_string(), qemu::build_toyos_bin(qemu::SUITE_ARCH, &root, j))).collect();
+    let mut qemu = QemuInstance::boot_with_options(test_config, &[], &bins, BootOptions { kernel_features: ACTUATOR_KERNEL, ..BootOptions::default() });
+    for job in jobs {
+        let result = qemu.run_test(&format!("test_rs_{job}"), Duration::from_secs(300));
+        eprintln!("  [scratch] {job}: exit={:?} error={:?}\n{}", result.exit_code, result.error, result.stdout);
+        if result.error.is_some() || result.exit_code != Some(0) {
+            return Err(format!("{job} failed: {:?} {:?}\n{}\nkernel:\n{}", result.exit_code, result.error, result.stdout, qemu.boot_log()));
+        }
+    }
+    Ok(())
