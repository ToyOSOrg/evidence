-        let header = get(&update, 12).wrapping_add(get(&update, 16)).wrapping_add(get(&update, 24));
-        let at = HEADER + data;
-        put(&mut update, at, extended.len() as u32);
-        for (i, &(sig, flags)) in extended.iter().enumerate() {
