+const fn flatten(rows: &[[[Tight; 4]; 8]; 32]) -> [[Tight; 4]; 256] {
+    let mut flat = [rows[0][0]; 256];
+    let mut n = 0;
+    while n < 256 {
+        flat[n] = rows[n / 8][n % 8];
+        n += 1;
+    }
+    flat
+}
