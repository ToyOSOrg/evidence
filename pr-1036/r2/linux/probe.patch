+//! PROBE (never lands): P-256's costs by part, for a bench's Linux. Run with
+//! `probe_timings --ignored --nocapture`; build once as is and once with the
+//! crate's `portable` feature to compare the field paths.
+
+use super::*;
+use core::hint::black_box;
+use std::time::Instant;
+use std::vec::Vec;
+
+fn time<T>(name: &str, iterations: u32, mut f: impl FnMut() -> T) {
+    let mut samples: Vec<f64> = (0..15)
+        .map(|_| {
+            let start = Instant::now();
+            for _ in 0..iterations {
+                black_box(f());
+            }
+            start.elapsed().as_nanos() as f64 / f64::from(iterations)
+        })
+        .collect();
+    samples.sort_by(f64::total_cmp);
+    std::println!("probe {name} median={:.1}ns min={:.1}ns", samples[7], samples[0]);
+}
+
+#[test]
+#[ignore]
+fn probe_timings() {
+    type F = Residue<P256Field, 4>;
+    type P = Point<P256, 4>;
+    let path = crate::arch::p256_mul(&[1, 0, 0, 0], &[1, 0, 0, 0]).is_some();
+    std::println!("probe path {}", if path { "bmi2-adx" } else { "portable" });
+    let x = F::from_montgomery(P256::GX);
+    let y = F::from_montgomery(P256::GY);
+    time("field/mul", 200_000, || black_box(x).mul(&black_box(y)));
+    time("field/square", 200_000, || black_box(x).square());
+    // Each result the next one's operand: latency rather than throughput.
+    let mut chained = x;
+    time("field/mul-chain", 200_000, || {
+        chained = chained.mul(&y);
+        chained
+    });
+    time("field/square-chain", 200_000, || {
+        chained = chained.square();
+        chained
+    });
+    if crate::arch::p256_mul_separated(&[1, 0, 0, 0], &[1, 0, 0, 0]).is_some() {
+        let (u, v) = (crate::montgomery::words4(&x), crate::montgomery::words4(&y));
+        time("field/mul-separated", 200_000, || crate::arch::p256_mul_separated(black_box(&u), black_box(&v)));
+        let mut c = u;
+        time("field/mul-separated-chain", 200_000, || {
+            c = crate::arch::p256_mul_separated(&c, &v).unwrap();
+            c
+        });
+    }
+    time("field/add", 200_000, || black_box(x).add(&black_box(y)));
+    time("field/sub", 200_000, || black_box(x).sub(&black_box(y)));
+    time("field/invert", 2_000, || black_box(x).invert());
+
+    let k = Scalar::<P256, 4>::from_bytes(&[0x5c; 32]).unwrap();
+    let g = P::base();
+    let q = g.mul(&k);
+    time("point/double", 50_000, || black_box(q).double());
+    time("point/add_incomplete", 50_000, || black_box(q).add_incomplete(&black_box(g)));
+    time("point/add_affine", 50_000, || black_box(q).add_affine(&P256_COMB[3][5]));
+    let mut table = [q; 16];
+    for j in 1..16 {
+        table[j] = table[j - 1].add_public(&q);
+    }
+    time("point/lookup16", 50_000, || P::lookup(&black_box(table), black_box(-7)));
+    time("affine/lookup16", 50_000, || Affine::lookup(&P256_COMB[black_box(9)], black_box(5)));
+    time("scalar/representative", 50_000, || black_box(&k).representative().0[0]);
+
+    time("mul/base_comb", 500, || P256::base_mul(black_box(&k)));
+    time("mul/variable", 200, || black_box(q).mul(black_box(&k)));
+    let mut encoded = [0u8; 65];
+    q.encode(&mut encoded).unwrap();
+    time("point/encode(affine)", 2_000, || {
+        let mut out = [0u8; 65];
+        black_box(q).encode(&mut out).unwrap();
+        out[1]
+    });
+    time("point/decode", 20_000, || P::decode(black_box(&encoded)).unwrap());
+    time("ecdh/whole", 200, || {
+        let public = P256::base_mul(black_box(&k));
+        let mut out = [0u8; 65];
+        public.encode(&mut out).unwrap();
+        let peer = P::decode(black_box(&encoded)).unwrap();
+        let mut secret = [0u8; 32];
+        peer.agree(&k, &mut secret);
+        (out[1], secret[0])
+    });
+
+    type N = ModN<P256, 4>;
+    let s = N::from_wide(&[0x1111, 0x2222, 0x3333, 0x4444]);
+    time("order/mul", 200_000, || black_box(s).mul(&black_box(s)));
+    time("order/invert", 2_000, || black_box(s).invert());
+    let u1 = PublicScalar([0x0123_4567_89ab_cdef, 0xfedc_ba98_7654_3210, 0x0f0f_0f0f_f0f0_f0f0, 0x7777_8888_9999_aaaa]);
+    let u2 = PublicScalar([0x1357_9bdf_2468_ace0, 0x0fed_cba9_8765_4321, 0xaaaa_5555_aaaa_5555, 0x6666_1111_2222_3333]);
+    time("verify/joint", 200, || black_box(q).joint(&u1, &u2));
+    // A well-formed signature that does not verify: all of the work.
+    let mut der = [0u8; 72];
+    der[..2].copy_from_slice(&[0x30, 68]);
+    der[2..4].copy_from_slice(&[0x02, 32]);
+    der[4..36].copy_from_slice(&[0x3a; 32]);
+    der[36..38].copy_from_slice(&[0x02, 32]);
+    der[38..70].copy_from_slice(&[0x45; 32]);
+    let der = &der[..70];
+    assert!(q.verify(&[0x99; 32], der).is_err());
+    time("verify/whole", 200, || black_box(q).verify(black_box(&[0x99; 32]), black_box(der)).is_err());
+}
