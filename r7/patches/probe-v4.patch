+/// Diagnostic probe: one I/O, from its submission to the reap that took its answer.
+#[derive(Clone, Copy, Debug)]
+struct Ev {
+    /// Submitted, in nanoseconds since boot (the diary's clock).
+    at_ns: u64,
+    op: u8,
+    lba: u64,
+    sectors: u32,
+    session: u64,
+    /// Since the device last went idle, where it was idle at this submission.
+    idle_ms: Option<u64>,
+    /// Submission to reap.
+    lat_us: u64,
+}
+
+/// Diagnostic probe: every I/O within [`WINDOW_MS`] of an arrival after at
+/// least [`WINDOW_AFTER_IDLE_MS`] idle, and every I/O of 2 ms or more, logged
+/// in batches at least 30 s apart. It issues no command of its own.
+#[derive(Debug)]
+struct Probe {
+    idle_since: Instant,
+    /// The idle time of the arrival being submitted, for its own event.
+    arriving: Option<(Instant, u64)>,
+    window: Option<Instant>,
+    events: Vec<Ev>,
+    said: Instant,
+}
+
+const WINDOW_AFTER_IDLE_MS: u64 = 50;
+const WINDOW_MS: u128 = 100;
+
+impl Probe {
+    fn new() -> Self {
+        Self { idle_since: Instant::now(), arriving: None, window: None, events: Vec::new(), said: Instant::now() }
+    }
+
+    fn arrival(&mut self, idle: bool) {
+        if !idle {
+            return;
+        }
+        let idle_ms = self.idle_since.elapsed().as_millis() as u64;
+        let now = Instant::now();
+        self.arriving = Some((now, idle_ms));
+        if idle_ms >= WINDOW_AFTER_IDLE_MS {
+            self.window = Some(now);
+        }
+        self.flush_lines();
+    }
+
+    fn completed(&mut self, slot: &Slot, session: u64) {
+        let lat = slot.since.elapsed();
+        let lat_us = lat.as_micros() as u64;
+        // The arrival's own event: submitted within a few microseconds of it.
+        let idle_ms = self
+            .arriving
+            .filter(|&(at, _)| slot.since >= at && slot.since.duration_since(at).as_micros() < 50)
+            .map(|(_, ms)| ms);
+        let in_window = self.window.is_some_and(|w| slot.since >= w && slot.since.duration_since(w).as_millis() <= WINDOW_MS);
+        if !(in_window || lat_us >= 2_000 || idle_ms.is_some_and(|ms| ms >= WINDOW_AFTER_IDLE_MS)) || self.events.len() >= 4096 {
+            return;
+        }
+        let at_ns = toyos_abi::clock::nanos_since_boot().saturating_sub(lat.as_nanos() as u64);
+        self.events.push(Ev { at_ns, op: slot.opcode, lba: slot.lba, sectors: slot.sectors, session, idle_ms, lat_us });
+    }
+
+    fn flush_lines(&mut self) {
+        if self.said.elapsed() < Duration::from_secs(30) || self.events.is_empty() {
+            return;
+        }
+        self.said = Instant::now();
+        for chunk in self.events.chunks(12) {
+            let evs: Vec<String> = chunk
+                .iter()
+                .map(|e| {
+                    let op = match e.op { 0x00 => "flush", 0x01 => "write", 0x02 => "read", _ => "op" };
+                    let idle = e.idle_ms.map_or("busy".to_string(), |ms| format!("idle {ms} ms"));
+                    format!("{}.{:06} {op} {}+{} s{} {idle} {} us", e.at_ns / 1_000_000_000, e.at_ns / 1_000 % 1_000_000, e.lba, e.sectors, e.session, e.lat_us)
+                })
+                .collect();
+            println!("nvme probe: {}", evs.join("; "));
+        }
+        self.events.clear();
+    }
+}
