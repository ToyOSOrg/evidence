@@ -0,0 +1,96 @@
+//! MEASUREMENT ONLY, never lands: every kernel `memcpy` by its destination's
+//! distance above its source modulo 4 KiB, and by its caller.
+
+use core::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+/// Buckets: n < 64; then d = 0, 1-15, 16-63, 64-255, 256-511, 512-1023, 1024+.
+const BUCKETS: usize = 8;
+static COUNT: [AtomicU64; BUCKETS] = [const { AtomicU64::new(0) }; BUCKETS];
+static BYTES: [AtomicU64; BUCKETS] = [const { AtomicU64::new(0) }; BUCKETS];
+
+const SLOTS: usize = 64;
+static RA: [AtomicU64; SLOTS] = [const { AtomicU64::new(0) }; SLOTS];
+/// Per caller: bytes at n >= 64, and of those at d in 1..512, and at d in 1..64.
+static RA_ALL: [AtomicU64; SLOTS] = [const { AtomicU64::new(0) }; SLOTS];
+static RA_512: [AtomicU64; SLOTS] = [const { AtomicU64::new(0) }; SLOTS];
+static RA_64: [AtomicU64; SLOTS] = [const { AtomicU64::new(0) }; SLOTS];
+static LAST: AtomicU64 = AtomicU64::new(0);
+
+extern "C" fn record(dest: usize, src: usize, n: usize, ra: u64) {
+    let d = dest.wrapping_sub(src) % 4096;
+    let b = if n < 64 {
+        0
+    } else {
+        match d {
+            0 => 1,
+            1..16 => 2,
+            16..64 => 3,
+            64..256 => 4,
+            256..512 => 5,
+            512..1024 => 6,
+            _ => 7,
+        }
+    };
+    COUNT[b].fetch_add(1, Relaxed);
+    BYTES[b].fetch_add(n as u64, Relaxed);
+    if n < 64 {
+        return;
+    }
+    let mut i = (ra.wrapping_mul(0x9E37_79B9_7F4A_7C15) >> 58) as usize;
+    for _ in 0..SLOTS {
+        let cur = RA[i].load(Relaxed);
+        if cur == ra || (cur == 0 && RA[i].compare_exchange(0, ra, Relaxed, Relaxed).map_or_else(|v| v == ra, |_| true)) {
+            RA_ALL[i].fetch_add(n as u64, Relaxed);
+            if (1..512).contains(&d) {
+                RA_512[i].fetch_add(n as u64, Relaxed);
+            }
+            if (1..64).contains(&d) {
+                RA_64[i].fetch_add(n as u64, Relaxed);
+            }
+            return;
+        }
+        i = (i + 1) % SLOTS;
+    }
+}
+
+#[unsafe(no_mangle)]
+#[unsafe(naked)]
+unsafe extern "C" fn memcpy(_dest: *mut core::ffi::c_void, _src: *const core::ffi::c_void, _n: usize) -> *mut core::ffi::c_void {
+    core::arch::naked_asm!(
+        "push rdi",
+        "push rsi",
+        "push rdx",
+        "mov rcx, [rsp + 24]",
+        "call {record}",
+        "pop rdx",
+        "pop rsi",
+        "pop rdi",
+        "mov rax, rdi",
+        "mov rcx, rdx",
+        "rep movsb",
+        "ret",
+        record = sym record,
+    );
+}
+
+/// Log the histogram and the caller table, if anything was copied since.
+pub fn dump(why: &str) {
+    let total: u64 = BYTES.iter().map(|b| b.load(Relaxed)).sum();
+    if LAST.swap(total, Relaxed) == total {
+        return;
+    }
+    let c: [u64; BUCKETS] = core::array::from_fn(|i| COUNT[i].load(Relaxed));
+    let b: [u64; BUCKETS] = core::array::from_fn(|i| BYTES[i].load(Relaxed));
+    crate::log!("memprobe {why} anchor={:#x} count={c:?} bytes={b:?}", record as *const () as usize);
+    for i in 0..SLOTS {
+        let ra = RA[i].load(Relaxed);
+        if ra != 0 {
+            crate::log!(
+                "memprobe ra={ra:#x} all={} d512={} d64={}",
+                RA_ALL[i].load(Relaxed),
+                RA_512[i].load(Relaxed),
+                RA_64[i].load(Relaxed)
+            );
+        }
+    }
+}
