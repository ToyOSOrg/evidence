===== shape.sh
#!/bin/bash
# Boots nothing: each run is QEMU stopped before its first instruction (-S),
# asked `info pci` and `quit` on its monitor, and its exit status recorded.
# Usage: shape.sh <log>
log="$1"
: > "$log"

run() { # run <label> <qemu> <args...>
  local label="$1"; shift
  {
    echo "### $label"
    printf '$ printf '"'"'info pci\\nquit\\n'"'"' |'
    printf ' %s' "$@"
    echo " | (the monitor's line-editing escapes stripped, its echo of each command collapsed)"
  } >> "$log"
  printf 'info pci\nquit\n' | "$@" 2>&1 | perl -pe 's/\e\[[0-9;?]*[A-Za-z]//g; s/\r//g; s/^\(qemu\) .*?(info pci|quit)$/(qemu) $1/' >> "$log"
  local st=${PIPESTATUS[1]}
  echo "EXIT=$st" >> "$log"
  echo >> "$log"
}

{ echo '$ qemu-system-x86_64 --version'; qemu-system-x86_64 --version; echo "EXIT=$?"; echo
  echo '$ qemu-system-aarch64 --version'; qemu-system-aarch64 --version; echo "EXIT=$?"; echo
  echo '$ qemu-system-x86_64 -chardev help'; qemu-system-x86_64 -chardev help; echo "EXIT=$?"; echo
  echo '$ qemu-system-aarch64 -machine virt -chardev help'; qemu-system-aarch64 -machine virt -chardev help; echo "EXIT=$?"; echo
  echo '$ qemu-system-x86_64 -display help'; qemu-system-x86_64 -display help; echo "EXIT=$?"; echo
} >> "$log" 2>&1

# Round 1's command line, unchanged but for the monitor's commands.
run "round 1's shape, info pci and quit only" \
  qemu-system-x86_64 -nodefaults -machine q35 -display none -S -monitor stdio -serial none \
  -chardev null,id=cs0 \
  -device virtio-serial-pci-non-transitional,id=virtio-serial0,max_ports=1 \
  -device virtconsole,chardev=cs0,id=console0 \
  -chardev qemu-vdagent,id=vdagent0,clipboard=on,mouse=off \
  -device virtio-serial-pci-non-transitional,id=vdagent-serial,max_ports=2 \
  -device virtserialport,bus=vdagent-serial.0,nr=1,chardev=vdagent0,name=com.redhat.spice.0

# build/qemu.rs's Virtio profile as the revised design launches it, the
# agent's function created before the console's; firmware, the image's drives,
# the host audio backend, -s and QMP left out, nothing else.
run "x86_64: cargo run's Virtio profile, the agent's function before the console's" \
  qemu-system-x86_64 -nodefaults -cpu qemu64 -machine q35,kernel-irqchip=split -smp cores=4 -m 2G \
  -display none -S -monitor stdio \
  -device intel-iommu,intremap=on,caching-mode=on,aw-bits=48 \
  -device nec-usb-xhci,id=xhci \
  -blockdev driver=null-co,node-name=stick,size=67108864 \
  -device usb-storage,bus=xhci.0,drive=stick,bootindex=0 \
  -blockdev driver=null-co,node-name=nvme0,size=134217728 \
  -device nvme,serial=deadbeef,drive=nvme0,msix-exclusive-bar=on \
  -device usb-kbd,bus=xhci.0 -device usb-tablet,bus=xhci.0 \
  -vga none -device virtio-gpu-pci,xres=1280,yres=720,iommu_platform=on \
  -netdev user,id=net0 -device virtio-net-pci-non-transitional,netdev=net0,iommu_platform=on \
  -audiodev none,id=audio0 -device virtio-sound-pci,audiodev=audio0,streams=1,iommu_platform=on \
  -serial none \
  -chardev qemu-vdagent,id=vdagent0,clipboard=on,mouse=off \
  -device virtio-serial-pci-non-transitional,id=vdagent-serial,max_ports=2,iommu_platform=on \
  -device virtserialport,bus=vdagent-serial.0,nr=1,chardev=vdagent0,name=com.redhat.spice.0 \
  -chardev null,id=cs0 \
  -device virtio-serial-pci-non-transitional,id=virtio-serial0,max_ports=1,iommu_platform=on \
  -device virtconsole,chardev=cs0,id=console0

run "aarch64: cargo run's Virtio profile, the agent's function before the console's" \
  qemu-system-aarch64 -nodefaults -cpu max -machine virt,gic-version=3,iommu=smmuv3 -smp cores=4 -m 2G \
  -display none -S -monitor stdio \
  -device nec-usb-xhci,id=xhci \
  -blockdev driver=null-co,node-name=stick,size=67108864 \
  -device usb-storage,bus=xhci.0,drive=stick,bootindex=0 \
  -blockdev driver=null-co,node-name=nvme0,size=134217728 \
  -device nvme,serial=deadbeef,drive=nvme0,msix-exclusive-bar=on \
  -device usb-kbd,bus=xhci.0 -device usb-tablet,bus=xhci.0 \
  -device virtio-gpu-pci,xres=1280,yres=720,iommu_platform=on \
  -device virtio-rng-pci \
  -netdev user,id=net0 -device virtio-net-pci-non-transitional,netdev=net0,iommu_platform=on \
  -audiodev none,id=audio0 -device virtio-sound-pci,audiodev=audio0,streams=1,iommu_platform=on \
  -serial none \
  -chardev qemu-vdagent,id=vdagent0,clipboard=on,mouse=off \
  -device virtio-serial-pci-non-transitional,id=vdagent-serial,max_ports=2,iommu_platform=on \
  -device virtserialport,bus=vdagent-serial.0,nr=1,chardev=vdagent0,name=com.redhat.spice.0 \
  -chardev null,id=cs0 \
  -device virtio-serial-pci-non-transitional,id=virtio-serial0,max_ports=1,iommu_platform=on \
  -device virtconsole,chardev=cs0,id=console0
