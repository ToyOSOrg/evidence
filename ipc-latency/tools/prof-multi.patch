diff --git a/tests/guest/osbench/src/prof.rs b/tests/guest/osbench/src/prof.rs
new file mode 100644
index 000000000..cd1c027d1
--- /dev/null
+++ b/tests/guest/osbench/src/prof.rs
@@ -0,0 +1,8 @@
+pub fn start() { marker(0x50524f46) }
+pub fn done() { marker(0x444f4e45) }
+fn marker(v: u32) {
+    #[cfg(target_arch = "x86_64")]
+    { core::arch::x86_64::__cpuid(v); }
+    #[cfg(not(target_arch = "x86_64"))]
+    let _ = v;
+}
