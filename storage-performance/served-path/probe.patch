+/// Probe (scratch): `osbench files` with the server's per-request profile.
+fn probe_osbench_files() -> Result<(), String> {
+    const JOBS: [&str; 1] = ["osbench_persist"];
+    let committed = compile::repo_root().join("tests/images/benchcase.toml");
+    let text = fs::read_to_string(&committed).map_err(|e| format!("{}: {e}", committed.display()))?;
+    let derived = toyos_metal::image::derive(&text, 600_000, &JOBS, &[]).map_err(|why| why.to_string())?;
+    let config = common::lane::dir().join("probe-osbench-files.toml");
+    fs::write(&config, derived).map_err(|e| format!("{}: {e}", config.display()))?;
+    let mut qemu = QemuInstance::boot_with_options(&config, &[], &[], BootOptions { profile: qemu::Profile::HeadlessNoUsb, ready_marker: bootlog::COMPLETE, ..Default::default() });
+    let mut console = format!("{}\n", qemu.boot_log());
+    let last = format!("===TEST_END {} ", JOBS[0]);
+    await_guest(&mut qemu, &mut console, "osbench files to end", |said| said.contains(&last))?;
+    for line in console.lines().filter(|l| l.contains("PROBE") || l.contains("bench=fs.") || l.contains("served_by")) {
+        eprintln!("PROBELINE {line}");
+    }
+    Ok(())
+}
