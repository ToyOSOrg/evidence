+        }
+        log!("M895 EDID bytes {hex}");
+        let cmd = UpdateCursor {
+            hdr: CtrlHeader::new(CMD_MOVE_CURSOR),
+            pos: CursorPos { scanout_id: 0, x: 1, y: 1, padding: 0 },
+            resource_id: 0,
+            hot_x: 0,
+            hot_y: 0,
+            padding: 0,
+        };
+        for writable in [false, true] {
