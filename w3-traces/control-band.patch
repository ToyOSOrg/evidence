     pub payload: Vec<u8>,
 }
 
+impl Command {
+    /// The command's 8-byte header (§8.2): its identifier and group, `sequence` (the descriptor's
+    /// slot in bits 7:0 and the queue in bits 12:8, the host's own count), the payload's length,
+    /// a reserved byte and version 0. `None` for a payload past what the length field holds.
+    pub fn header(&self, sequence: u16) -> Option<[u8; 8]> {
+        let [s0, s1] = sequence.to_le_bytes();
+        let [l0, l1] = u16::try_from(self.payload.len()).ok()?.to_le_bytes();
+        Some([self.message.id.id, self.message.id.group, s0, s1, l0, l1, 0, 0])
+    }
+}
+
 /// A payload as it is written, field by field.
 struct Out(Vec<u8>);
 
