$ cat e11.sh
#!/bin/bash
# E11: the NOTICE entries each branch on origin holding the demo's first commit
# adds past origin/main, by heading (a NOTICE entry's heading line carries an
# em dash). The bench's model name is masked in either case.
# argv: <worktree> <demo's first commit> <word to mask, lower case>
set -u
repo=$1 first=$2 mask=$3
upper=$(echo "$mask" | tr '[:lower:]' '[:upper:]')
m() { sed -e "s/$mask/<bench>/g" -e "s/$upper/<BENCH>/g"; }
cd "$repo" || exit 2
echo "\$ git rev-parse origin/main"; git rev-parse origin/main
git ls-remote origin 'refs/heads/*' > "$TMPDIR/e11-heads" || exit 3
while read -r sha ref; do
  git merge-base --is-ancestor "$first" "$sha" || continue
  echo "$ref $sha" | m
  git diff -U0 "origin/main...$sha" -- NOTICE 2>/dev/null | grep '^+[^+]' | grep '—' | m
done < "$TMPDIR/e11-heads"

