+    /// MEASUREMENT ONLY: osbench's fs.disk.seq_read.4096 at the cache's own
+    /// limit: a 64 MiB file written in 4 KiB calls and synced, then read
+    /// whole in 4 KiB calls, five rounds; print the disk blocks each round read.
+    #[test]
+    fn probe_seq_read_4096_at_the_limit() {
+        const MIB: usize = 1 << 20;
+        let mut v = DataVolume::format(Stops::new(40_000), &["home", "apps"], clock).unwrap();
+        let n = v.open("home/seq", CREATE).unwrap();
+        let page: Vec<u8> = (0..BLOCK).map(|i| (i % 253) as u8).collect();
+        for k in 0..64 * MIB / BLOCK {
+            v.write(n, (k * BLOCK) as u64, &page).unwrap();
+        }
+        v.close(n).unwrap();
+        assert_eq!(v.sync(), Ok(Vec::new()));
+        let mut out = vec![0u8; BLOCK];
+        for round in 0..5 {
+            let before = v.cache.disk().reads.get();
+            let n = v.open("home/seq", PLAIN).unwrap();
+            for k in 0..64 * MIB / BLOCK {
+                assert_eq!(v.read(n, (k * BLOCK) as u64, &mut Buf(&mut out)).unwrap(), BLOCK);
+            }
+            v.close(n).unwrap();
+            println!("probe seq_read round {round}: disk blocks read {}", v.cache.disk().reads.get() - before);
+        }
+    }
+
+    /// MEASUREMENT ONLY: osbench's persist.seq_write_fsync. Each round
+    /// truncates the file, writes 8 MiB in 1 MiB calls and syncs; print the
+    /// file's runs and the disk write requests the sync made.
+    #[test]
+    fn probe_seq_write_fsync_fragmentation() {
+        const MIB: usize = 1 << 20;
+        let mut v = DataVolume::format(Stops::new(200_000), &["home", "apps"], clock).unwrap();
+        let chunk = vec![0x2du8; MIB];
+        let how = OpenHow { create: true, create_new: false, truncate: true };
+        // Aged as osbench persist ages DATA before this row: a 4 KiB append
+        // synced 105 times, then 55 files created, written, synced and removed.
+        let log = v.open("home/log", CREATE).unwrap();
+        for k in 0..105u64 {
+            v.write(log, k * BLOCK as u64, &[7; BLOCK]).unwrap();
+            assert_eq!(v.sync(), Ok(Vec::new()));
+        }
+        for _ in 0..55 {
+            let f = v.open("home/fresh", CREATE).unwrap();
+            v.write(f, 0, &[8; BLOCK]).unwrap();
+            assert_eq!(v.sync(), Ok(Vec::new()));
+            v.close(f).unwrap();
+            v.unlink("home/fresh").unwrap();
+        }
+        for round in 0..6 {
+            let (b0, r0) = (v.cache.disk().writes.get(), v.cache.disk().requests.get());
+            let n = v.open("home/seq", how).unwrap();
+            for k in 0..8 {
+                v.write(n, (k * MIB) as u64, &chunk).unwrap();
+            }
+            let lens: Vec<u32> = v.open[&n].extents.iter().map(|e| e.block_count).collect();
+            let (before, asked) = (v.cache.disk().writes.get(), v.cache.disk().requests.get());
+            assert_eq!(v.sync(), Ok(Vec::new()));
+            let (blocks, requests) = (v.cache.disk().writes.get() - before, v.cache.disk().requests.get() - asked);
+            println!("probe seq_write whole round: blocks {} in {} requests", v.cache.disk().writes.get() - b0, v.cache.disk().requests.get() - r0);
+            v.close(n).unwrap();
+            println!("probe seq_write round {round}: blocks written {blocks} in {requests} requests, file runs {}: {lens:?}", lens.len());
+        }
+    }
