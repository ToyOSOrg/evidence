$ cat e10.sh
#!/bin/bash
# E10: E3's count taken over origin as it stands: every branch on origin that
# holds the demo's first commit, those of them touching a Wi-Fi-named path past
# origin/main, and what each adds to NOTICE, and how much of that names a reference (a driver or supplicant source, never the firmware). The bench's
# model name is masked.
# argv: <worktree> <demo's first commit> <word to mask> <scratch dir>
set -u
repo=$1 first=$2 mask=$3 scratch=$4
m() { sed "s/$mask/<bench>/g"; }
cd "$repo" || exit 2
echo "\$ git fetch origin"; git fetch origin 2>&1 | m; echo "exit ${PIPESTATUS[0]}"
echo "\$ git rev-parse origin/main"; git rev-parse origin/main
echo "\$ git ls-remote origin 'refs/heads/*'"; git ls-remote origin 'refs/heads/*' > "$scratch/heads"; echo "exit $?, $(wc -l < "$scratch/heads" | tr -d ' ') branches"
holding=0 touching=0 naming=0
while read -r sha ref; do
  git cat-file -e "$sha^{commit}" 2>/dev/null || git fetch -q origin "$sha" 2>/dev/null
  git merge-base --is-ancestor "$first" "$sha" || continue
  holding=$((holding+1))
  n=$(git log --name-only --format= "origin/main..$sha" | grep -c -i -E 'wifi|iwl|iwx|80211|wpa|wlan|eapol|supplicant')
  ahead=$(git rev-list --count "origin/main..$sha")
  added=$(git diff -U0 "origin/main...$sha" -- NOTICE 2>/dev/null | grep -c '^+[^+]')
  refs=$(git diff -U0 "origin/main...$sha" -- NOTICE 2>/dev/null | grep '^+[^+]' | grep -c -i -E 'openbsd|iwx|hostap|wpa_supplicant|mac80211|cfg80211|drivers/net/wireless|isc licen')
  echo "$ref $sha: commits past main $ahead, Wi-Fi-named path lines $n, NOTICE lines added $added, of them naming a reference $refs" | m
  [ "$n" -gt 0 ] && touching=$((touching+1))
  [ "$refs" -gt 0 ] && naming=$((naming+1))
done < "$scratch/heads"
echo
echo "branches on origin holding ${first:0:12}: $holding"
echo "of them touching a Wi-Fi-named path: $touching"
echo "of them adding a NOTICE line that names a reference: $naming"

