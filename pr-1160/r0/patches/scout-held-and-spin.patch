+/// SCOUT (never committed): the holder of a `Lock`, as its acquisition wrote it.
+#[cfg(not(feature = "loom"))]
+struct Scout {
+    who: core::sync::atomic::AtomicU64,
+    site: core::sync::atomic::AtomicPtr<core::panic::Location<'static>>,
+    ret: [core::sync::atomic::AtomicU64; 4],
+}
+
+#[cfg(not(feature = "loom"))]
+impl Scout {
+    const fn new() -> Self {
+        Self {
+            who: core::sync::atomic::AtomicU64::new(0),
+            site: core::sync::atomic::AtomicPtr::new(core::ptr::null_mut()),
+            ret: [const { core::sync::atomic::AtomicU64::new(0) }; 4],
+        }
+    }
+
+    #[track_caller]
+    fn took(&self) {
+        if !crate::log::PERCPU_READY.load(Ordering::Relaxed) {
+            return;
+        }
+        let task = crate::scheduler::current_task().map_or(0xFFFF_FFFF_FFFF, |t| t.pack());
+        let who = 1 << 63 | (crate::arch::percpu::cpu_id() as u64) << 48 | task & 0xFFFF_FFFF_FFFF;
+        self.who.store(who, Ordering::Relaxed);
+        self.site.store(core::panic::Location::caller() as *const _ as *mut _, Ordering::Relaxed);
+        let mut fp = crate::arch::cpu::frame_pointer();
+        for slot in &self.ret {
+            let ret = if fp != 0 && fp.is_multiple_of(8) && crate::mm::is_kernel_addr(fp) {
+                // SAFETY: a scout's walk of this stack's own frame records.
+                let (next, ret) = unsafe { (*(fp as *const u64), *((fp + 8) as *const u64)) };
+                fp = next;
+                ret
+            } else {
+                0
+            };
+            slot.store(ret, Ordering::Relaxed);
+        }
+    }
+
+    fn gave(&self) {
+        self.who.store(0, Ordering::Relaxed);
+    }
+
+    fn report(&self, lock: u64, caller: &core::panic::Location<'_>, ticket: u32, now: u32) {
+        let who = self.who.load(Ordering::Relaxed);
+        let site = self.site.load(Ordering::Relaxed);
+        // SAFETY: a scout's read of a `&'static Location` it stored.
+        let site = if site.is_null() { None } else { Some(unsafe { &*site }) };
+        crate::log!(
+            "SCOUT-SPIN lock {lock:#x} at {caller}: ticket={ticket} now={now}; holder word {who:#x} (cpu {} task {:#x}) from {site:?}",
+            (who >> 48) & 0x7FFF,
+            who & 0xFFFF_FFFF_FFFF,
+        );
+        for ret in &self.ret {
+            let ret = ret.load(Ordering::Relaxed);
+            match crate::symbols::kernel_symbol(ret) {
+                Some((name, off)) => crate::log!("SCOUT-SPIN   holder frame {ret:#x} {name}+{off:#x}"),
+                None => crate::log!("SCOUT-SPIN   holder frame {ret:#x}"),
+            }
+        }
+        for cpu in 0..crate::smp::cpu_count() as usize {
+            crate::log!("SCOUT-SPIN   cpu{cpu} holds or queues {}", SCOUT_HELD[cpu].load(Ordering::Relaxed));
+        }
+        crate::hw::report_contexts(0, None);
+        crate::symbols::kernel_backtrace(crate::arch::cpu::frame_pointer(), 12);
+    }
 }
 
