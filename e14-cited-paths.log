$ cat e14.sh
#!/bin/bash
# E14: every path #876's body, the Wi-Fi track and the six issues this branch
# adds cite, checked at the branch's head. A cited path is a backticked token
# holding a '/' or ending in .md, .rs or .toml, other than a ref or a
# branch's or a repository's name (origin/, wt/, refs/, codex/, ToyOSOrg/); a
# brace list is expanded. A path the head lacks is read as a short form: present
# when exactly one tracked file ends in it. A .log path is the evidence
# repository's, checked on its pr-876 branch. The paths the body names as not
# yet existing, and the demo's own path, are listed apart and must be absent.
# argv: <worktree> <head> <the body file> <evidence clone>
set -u
repo=$1 head=$2 body=$3 ev=$4
absent_by_design='lib/crypto system/ax2xx system/ax2xx/firmware netstack/src/wifi.rs'
cd "$repo" || exit 2
echo "\$ git rev-parse $head"; git rev-parse "$head" || exit 2
files="issues/there-is-no-wifi.md issues/pcidev-moves-a-bar-behind-a-bridge-out-of-the-range-the-bridge-forwards.md issues/netstack-drives-one-card.md issues/no-access-point-answers-to-the-harness.md issues/acpiserver-serves-no-client.md issues/a-platform-with-no-transmit-power-table-joins-no-wifi-network.md issues/the-wifi-demos-commits-still-resolve-on-origin.md"
{ cat "$body"; for f in $files; do git show "$head:$f"; done; } \
  | grep -o '`[^` ]*`' | tr -d '`' \
  | grep -E '/|\.(md|rs|toml)$' | grep -v -E '^https?:|^[.]*$|<|\*|^(origin|wt|refs|codex|ToyOSOrg)/' \
  | while read -r p; do
      if [[ $p == *'{'* ]]; then
        pre=${p%%\{*}; rest=${p#*\{}; list=${rest%%\}*}; post=${rest#*\}}
        IFS=, read -ra parts <<< "$list"; for x in "${parts[@]}"; do echo "$pre$x$post"; done
      else echo "$p"; fi
    done | sed 's#/$##' | sort -u > "$TMPDIR/e14-paths"
missing=0 present=0 bydesign=0
while read -r p; do
  if [[ " $absent_by_design " == *" $p "* ]]; then
    if git cat-file -e "$head:$p" 2>/dev/null; then echo "PRESENT, named absent: $p"; missing=$((missing+1)); else echo "absent, as named: $p"; bydesign=$((bydesign+1)); fi
  elif git cat-file -e "$head:$p" 2>/dev/null; then echo "present $p"; present=$((present+1))
  elif [[ $p == *.log ]] && git -C "$ev" cat-file -e "origin/pr-876:$p" 2>/dev/null; then echo "present on evidence pr-876: $p"; present=$((present+1))
  else
    full=$(git ls-tree -r --name-only "$head" | grep -E -- "/${p//./\\.}$")
    if [ "$(echo "$full" | grep -c .)" -eq 1 ]; then echo "present, short for $full: $p"; present=$((present+1))
    else echo "MISSING $p ($(echo "$full" | grep -c .) files end in it)"; missing=$((missing+1)); fi
  fi
done < "$TMPDIR/e14-paths"
rm -f "$TMPDIR/e14-paths"
echo "present=$present absent-as-named=$bydesign missing=$missing"
[ "$missing" -eq 0 ]

