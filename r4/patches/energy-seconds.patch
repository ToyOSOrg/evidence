+/// Diagnostic: each idle second's events, off the kernel's diary and the
+/// round's counters, said after the row so the saying is outside it.
+#[cfg(target_os = "toyos")]
+mod seconds_diag {
+    use std::collections::BTreeMap;
+
+    use toyos_trace::Event;
+
+    use crate::report::note;
+    use crate::sys::{diag::Diag, CpuPower, Package};
+
+    pub struct Each {
+        diag: Diag,
+        names: BTreeMap<(u32, u32), (String, u64)>,
+        lines: Vec<Vec<(&'static str, String)>>,
+    }
+
+    impl Each {
+        pub fn open() -> Option<Self> {
+            let mut diag = crate::sys::diag::open()?;
+            if !diag.has_diary() {
+                return None;
+            }
+            diag.diary();
+            let names = diag.roster();
+            Some(Self { diag, names, lines: Vec::new() })
+        }
+
+        pub fn second(&mut self, k: u64, before: &Package, after: &Package, first: &[CpuPower], last: &[CpuPower]) {
+            let (records, lost, _) = self.diag.diary();
+            let cpus = last.len().max(1);
+            let (mut fires, mut idles, mut wakes) = (vec![0u32; cpus], vec![0u32; cpus], BTreeMap::<String, u32>::new());
+            for (_, e) in &records {
+                let c = (e.cpu as usize).min(cpus - 1);
+                match e.event {
+                    Event::TimerFire | Event::TimerFireBurst { .. } => fires[c] += 1,
+                    Event::IdleEnter => idles[c] += 1,
+                    Event::Wake => {
+                        let name = e
+                            .thread
+                            .and_then(|t| self.names.get(&(t.pid, t.tid)).map(|(n, _)| n.clone()).or(Some(format!("{}/{}", t.pid, t.tid))))
+                            .unwrap_or_default();
+                        *wakes.entry(format!("{name}@{}", e.cpu)).or_default() += 1;
+                    }
+                    _ => {}
+                }
+            }
+            let c0: Vec<String> = last
+                .iter()
+                .map(|b| {
+                    first
+                        .iter()
+                        .find(|a| a.cpu == b.cpu)
+                        .and_then(|a| Some((b.mperf?.wrapping_sub(a.mperf?), b.tsc.wrapping_sub(a.tsc))))
+                        .map_or("-".to_string(), |(m, t)| osbench_rules::window::permille(m, t).to_string())
+                })
+                .collect();
+            let ticks = after.tsc.wrapping_sub(before.tsc);
+            let pc2 = before.residency[0]
+                .zip(after.residency[0])
+                .map_or("-".to_string(), |(a, b)| osbench_rules::window::permille(b.wrapping_sub(a), ticks).to_string());
+            let join = |v: &[u32]| v.iter().map(u32::to_string).collect::<Vec<_>>().join("/");
+            let wakes: Vec<String> = wakes.iter().map(|(n, c)| format!("{n}x{c}")).collect();
+            self.lines.push(vec![
+                ("s", k.to_string()),
+                ("end_ns", toyos_abi::clock::nanos_since_boot().to_string()),
+                ("pc2", pc2),
+                ("c0_permille", c0.join("/")),
+                ("fires", join(&fires)),
+                ("idles", join(&idles)),
+                ("lost", lost.to_string()),
+                ("wakes", wakes.join(",")),
+            ]);
+        }
+
+        pub fn report(self) {
+            for line in &self.lines {
+                note("energy.idle.second", line);
+            }
+        }
+    }
+}
