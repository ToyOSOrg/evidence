         let mut bytes = host(1, &[0; 12]);
         bytes.extend(host(wire::RELEASE, &[]));
         assert_eq!(decode(&bytes), (vec![Err(Refusal::Kind { kind: 1 }), Ok(Message::Release)], Ok(())));
