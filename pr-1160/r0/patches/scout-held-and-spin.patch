+/// SCOUT (never committed): `sync::Lock`s this CPU holds or queues for.
+#[cfg(not(feature = "loom"))]
+pub static SCOUT_HELD: [AtomicU32; 64] = [const { AtomicU32::new(0) }; 64];
+
+#[cfg(not(feature = "loom"))]
+#[inline]
+fn scout_held(delta: u32) {
+    if crate::log::PERCPU_READY.load(Ordering::Relaxed) {
+        SCOUT_HELD[crate::arch::percpu::cpu_id() as usize].fetch_add(delta, Ordering::Relaxed);
+    }
+}
+
+#[cfg(feature = "loom")]
+fn scout_held(_: u32) {}
