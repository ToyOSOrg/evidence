+# The boot `the_opening_exchange_with_qemus_agent_completes` reads: the
+# clipboard agent against QEMU's own vdagent, with the compositor whose
+# clipboard it watches, on `Profile::HeadlessVirtioGpu`, the one virtio machine
+# with a framebuffer for the compositor to claim.
+#
+# test-runner makes the boot announce itself.
+
+assets = ["assets"]
+
+[boot]
+start = ["logkeeper", "compositor", "test-runner"]
+
+# `every_boot_config_runs_logkeeper` is what refuses a boot config without it.
+[programs.logkeeper]
+service = true
+syscap = ["logread"]
+
+[programs.compositor]
+service = true
+serves = ["compositor", "prompt", "clipboard"]
+devices = ["framebuffer", "keyboard", "mouse"]
+
+[programs.test-runner]
