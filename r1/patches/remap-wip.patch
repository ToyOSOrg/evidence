+fn remap() {
+    // Two committed pages with free pages after them: a reservation's head
+    // replaced and its tail given back.
+    let at = reserve(16 * PAGE, VmProt::None);
+    assert_eq!(fixed(at, 2 * PAGE), Ok(at), "commit the head");
+    unsafe { syscall::vm_release(at.add(2 * PAGE), 14 * PAGE) }.expect("free the tail");
+    set(at, 0, 0x51);
+    assert_eq!(remap_of(at, 2, 6, false), Ok(at), "grow into the free pages after it");
+    assert_eq!((byte(at, 0), byte(at, 1), byte(at, 5)), (0x51, 0, 0), "growing in place changed what it held");
+    (0..6).for_each(|page| set(at, page, 0x60 + page as u8));
+
+    // Something after it: in place is refused, and moving is not.
+    assert_eq!(fixed(unsafe { at.add(6 * PAGE) }, PAGE), Ok(unsafe { at.add(6 * PAGE) }), "a page right after it");
+    assert_eq!(remap_of(at, 6, 8, false), Err(SyscallError::ResourceExhausted), "grow in place over a neighbour");
+    assert_eq!(byte(at, 5), 0x65, "a refused remap changed the range");
+    unsafe { syscall::vm_discard(at.add(PAGE), PAGE) }.expect("leave its second page unpopulated");
+    let moved = remap_of(at, 6, 8, true).expect("grow by moving");
+    assert_ne!(moved, at, "it moved");
+    let held: Vec<u8> = (0..8).map(|page| byte(moved, page)).collect();
+    assert_eq!(held, [0x60, 0, 0x62, 0x63, 0x64, 0x65, 0, 0], "a move kept other bytes than its pages'");
+    set(moved, 7, 0x77);
+    assert_eq!(unsafe { syscall::vm_protect(at, PAGE, VmProt::Read) }, Err(SyscallError::BadAddress), "the old range is still held");
+
+    // A shrink takes the tail away and keeps the rest.
+    assert_eq!(remap_of(moved, 8, 3, true), Ok(moved), "shrink in place");
+    assert_eq!(byte(moved, 2), 0x62, "a shrink took a page it kept");
+    assert_eq!(unsafe { syscall::vm_protect(moved.add(3 * PAGE), PAGE, VmProt::Read) }, Err(SyscallError::BadAddress), "a shrink kept its tail");
+
+    // What remap refuses, all or nothing: growth past memory, memory no one
+    // private committed range holds, a hole, and no bytes.
+    assert_eq!(remap_of(moved, 3, 1 << 28, true), Err(SyscallError::ResourceExhausted), "a tebibyte's growth");
