+        fs.create("b", b"two", 3).expect("create");
+        fs.io().refuse.set(Some(fs.io().syncs.get() + 1));
+        assert!(fs.sync().is_err(), "the device refused the sync after the superblock");
+        let (writes, _) = fs.io().counts();
+        fs.sync().expect("the commit again");
