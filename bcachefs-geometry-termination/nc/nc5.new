                        writes.push((p.sector, bytes));
                    }
                    let old = { let st = self.st.borrow(); let n = st.cache.node(id); (n.written > 0).then_some(n.sector) };
                    if let Some(old) = old {
                        let first = writes.last().unwrap().1.clone();
                        writes.push((old, first));
                    }
