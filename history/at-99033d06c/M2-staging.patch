+
+/// STAGING for mutation M2: cpu4 idle in the half of the T14 whose CPUs each
+/// hold one queued task, which no probe takes, beside cpu0 holding two.
+#[test]
+fn m2_group_imbalance_staged() {
+    let mut scenario =
+        scenarios::lopsided_placement(8, 12, 360 * MS).with_topology(Shape::t14());
+    scenario.placement =
+        kernel_sim::workload::PlacementShape::Listed(&[0, 0, 0, 1, 2, 3, 5, 5, 6, 6, 7, 7]);
+    for outcome in sweep(&scenario, WC_SEEDS) {
+        assert!(outcome.passed(), "{}", outcome.report());
+    }
+}
