+
+/// Evidence only (PR #905): std streams through netstack, connect, bulk both
+/// ways, close, and an accepted stream the guest hangs up.
+fn netstack_streams() -> Result<(), String> {
+    use std::io::Read;
+    use std::sync::mpsc;
+    const JOB: &str = "netstack_streams";
+    const LISTENER: u16 = 7010;
+    let echo = std::net::TcpListener::bind(("127.0.0.1", 0)).map_err(|e| format!("echo: {e}"))?;
+    let port = echo.local_addr().unwrap().port();
+    let bin = qemu::build_toyos_bin(qemu::SUITE_ARCH, &compile::repo_root().join("tests/guest/rust-tests"), JOB);
+    let options = BootOptions { qmp: true, profile: qemu::Profile::Headless, ..Default::default() };
+    let case = compile::repo_root().join("tests/images/netcase.toml");
+    let mut qemu = QemuInstance::boot_with_options(&case, &[], &[(JOB.to_string(), bin)], options);
+    let mut console = qemu.boot_log().to_string();
+    await_marker(&mut qemu, &mut console, "netstack: DHCP: lease ", "netstack's lease").map_err(|e| format!("{e}\n{console}"))?;
+    let mut monitor = qemu::QmpMonitor::open(qemu.qmp_socket());
+    let said = monitor.human(&format!("hostfwd_add net0 tcp:127.0.0.1:0-:{LISTENER}"));
+    if !said.trim().is_empty() {
+        return Err(format!("hostfwd: {said}"));
+    }
+    let table = monitor.human("info usernet");
+    let to_listener: u16 = table
+        .lines()
+        .map(|row| row.split_whitespace().collect::<Vec<_>>())
+        .find(|row| row.first() == Some(&"TCP[HOST_FORWARD]") && row.get(5) == Some(&LISTENER.to_string().as_str()))
+        .and_then(|row| row[3].parse().ok())
+        .ok_or_else(|| format!("no forward:\n{table}"))?;
+    let (tx, rx) = mpsc::channel();
+    thread::spawn(move || {
+        let (stream, _) = echo.accept().expect("the guest's bulk stream");
+        let mut back = stream.try_clone().unwrap();
+        let copied = std::io::copy(&mut &stream, &mut back);
+        drop(back);
+        drop(stream);
+        let answer = (|| -> Result<(u8, usize), String> {
+            let mut peer = std::net::TcpStream::connect(("127.0.0.1", to_listener)).map_err(|e| e.to_string())?;
+            peer.set_read_timeout(Some(Duration::from_secs(60))).unwrap();
+            peer.write_all(b"1").map_err(|e| e.to_string())?;
+            let mut a = [0u8; 1];
+            peer.read_exact(&mut a).map_err(|e| format!("answer: {e}"))?;
+            let mut rest = Vec::new();
+            let n = peer.read_to_end(&mut rest).map_err(|e| format!("end: {e}"))?;
+            Ok((a[0], n))
+        })();
+        tx.send((copied.map_err(|e| e.to_string()), answer)).unwrap();
+    });
+    let result = qemu.run_test(&format!("test_rs_{JOB} {port} {LISTENER}"), Duration::from_secs(240));
+    println!("guest said:\n{}", result.stdout);
+    if let Some(why) = &result.error {
+        return Err(format!("{why}\n{}", result.stdout));
+    }
+    if result.exit_code != Some(0) || !result.stdout.contains("netstack_streams: ok") {
+        return Err(format!("the job ended {:?}", result.exit_code));
+    }
+    let (copied, answer) = rx.recv_timeout(Duration::from_secs(60)).map_err(|e| format!("host side: {e}"))?;
+    println!("host: echoed {copied:?}; the dialled peer read {answer:?}");
+    match (copied, answer) {
+        (Ok(n), Ok((b'1', 0))) if n == 4 * 1024 * 1024 => Ok(()),
+        other => Err(format!("host side: {other:?}")),
+    }
+}
