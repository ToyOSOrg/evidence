+    /// The lowest signal pending that `mask` leaves unblocked, taken.
+    pub(crate) fn take(&mut self, mask: u64) -> Option<Delivery> {
+        let open = self.pending & !mask;
+        if open == 0 {
+            return None;
+        }
+        let sig = open.trailing_zeros() as i32 + 1;
+        self.pending &= !bit(sig);
