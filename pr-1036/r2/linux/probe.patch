+//! PROBE (never lands): RSA verification's costs by part, as `nist`'s probe.
+
+use super::*;
+use core::hint::black_box;
+use std::time::Instant;
+use std::vec::Vec;
+
+fn time<T>(name: &str, iterations: u32, mut f: impl FnMut() -> T) {
+    let mut samples: Vec<f64> = (0..15)
+        .map(|_| {
+            let start = Instant::now();
+            for _ in 0..iterations {
+                black_box(f());
+            }
+            start.elapsed().as_nanos() as f64 / f64::from(iterations)
+        })
+        .collect();
+    samples.sort_by(f64::total_cmp);
+    std::println!("probe {name} median={:.1}ns min={:.1}ns", samples[7], samples[0]);
+}
+
+#[test]
+#[ignore]
+fn probe_rsa_timings() {
+    for len in [256usize, 512] {
+        let mut modulus: Vec<u8> = (0..len).map(|i| (i * 131 + 7) as u8).collect();
+        modulus[0] |= 0x80;
+        modulus[len - 1] |= 1;
+        let key = PublicKey::from_components(&modulus, &[1, 0, 1]).unwrap();
+        let bits = len * 8;
+        time(&std::format!("rsa-{bits}/from_components"), 200, || PublicKey::from_components(black_box(&modulus), &[1, 0, 1]).unwrap().n0);
+        let mut a = [0u64; WORDS];
+        for (i, w) in a[..key.words].iter_mut().enumerate() {
+            *w = (i as u64).wrapping_mul(0x9e37_79b9_7f4a_7c15) >> 1;
+        }
+        let mut out = [0u64; WORDS];
+        time(&std::format!("rsa-{bits}/mul"), 5_000, || {
+            key.mul(black_box(&a), black_box(&a), &mut out);
+            out[0]
+        });
+        time(&std::format!("rsa-{bits}/power"), 200, || key.power(black_box(&a))[0]);
+        let signature: Vec<u8> = (0..len).map(|i| if i == 0 { 0x11 } else { (i * 7) as u8 }).collect();
+        time(&std::format!("rsa-{bits}/verify_pkcs1(whole, failing)"), 200, || {
+            PublicKey::from_components(black_box(&modulus), &[1, 0, 1])
+                .unwrap()
+                .verify_pkcs1_v1_5(Hash::Sha256, b"message", black_box(&signature))
+                .is_err()
+        });
+    }
+}
