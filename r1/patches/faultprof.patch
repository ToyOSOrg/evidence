diff --git a/kernel/src/faultprof.rs b/kernel/src/faultprof.rs
new file mode 100644
index 000000000..d6c3e3bf8
--- /dev/null
+++ b/kernel/src/faultprof.rs
@@ -0,0 +1,44 @@
+//! SCRATCH, never committed: where a first touch's time goes, in counter
+//! ticks summed per part and logged as nanoseconds every 2^16 faults.
+
+use core::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+pub const FAULTS: usize = 0;
+pub const FRAMES: usize = 1;
+pub const DISPATCH: usize = 2;
+pub const PRELOCK: usize = 3;
+pub const LOCKED: usize = 4;
+pub const ALLOC: usize = 5;
+pub const ZERO: usize = 6;
+pub const POST: usize = 7;
+
+static SUM: [AtomicU64; 8] = [const { AtomicU64::new(0) }; 8];
+
+#[inline(always)]
+pub fn now() -> u64 {
+    crate::arch::cpu::counter()
+}
+
+#[inline(always)]
+pub fn add(part: usize, ticks: u64) {
+    SUM[part].fetch_add(ticks, Relaxed);
+}
+
+/// One fault's dispatch done: count it and log every 2^16.
+pub fn done(dispatch: u64) {
+    add(DISPATCH, dispatch);
+    let n = SUM[FAULTS].fetch_add(1, Relaxed) + 1;
+    if n % (1 << 16) != 0 {
+        return;
+    }
+    let period = crate::clock::period_fs();
+    let ns = |part: usize, per: u64| (SUM[part].swap(0, Relaxed) as u128 * period as u128 / 1_000_000 / per.max(1) as u128) as u64;
+    let frames = SUM[FRAMES].swap(0, Relaxed);
+    let faults = 1u64 << 16;
+    let (dispatch, prelock, locked, post) = (ns(DISPATCH, faults), ns(PRELOCK, faults), ns(LOCKED, faults), ns(POST, faults));
+    let (alloc, zero) = (ns(ALLOC, frames), ns(ZERO, frames));
+    SUM[FAULTS].store(0, Relaxed);
+    crate::log!(
+        "faultprof: faults={faults} frames={frames} per fault ns: dispatch={dispatch} prelock={prelock} locked={locked} post={post}; per frame ns: alloc={alloc} zero={zero}"
+    );
+}
