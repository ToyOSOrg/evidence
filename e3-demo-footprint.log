$ cat e3.py
# E3: the demo's footprint in the shared repository, with the bench's model name masked.
# argv: <primary checkout> <demo branch> <word to mask>
import subprocess, sys, re
repo, demo, mask = sys.argv[1], sys.argv[2], sys.argv[3]
def m(s): return s.replace(mask, "<bench>")
def git(*a):
    r = subprocess.run(["git", "-C", repo, *a], capture_output=True, text=True)
    return r.returncode, r.stdout
def show(cmd, out):
    print("$ " + m(cmd)); print(m(out).rstrip()); print()
c, out = git("rev-list", "--count", "origin/main.." + demo)
show(f"git rev-list --count origin/main..{demo}", out); assert c == 0
c, mb = git("merge-base", "origin/main", demo); mb = mb.strip()
c, first = git("rev-list", "--reverse", f"{mb}..{demo}"); first = first.split()[0]
show(f"git rev-list --reverse $(git merge-base origin/main {demo})..{demo} | first", first)
c, refs = git("for-each-ref", "--contains", first, "--format=%(refname)")
show(f"git for-each-ref --contains {first[:12]} --format=%(refname)", refs)
heads = [r[len("refs/heads/"):] for r in refs.split() if r.startswith("refs/heads/")]
print(f"local branches containing it: {len(heads)}; remote-tracking: {sum(r.startswith('refs/remotes/') for r in refs.split())}\n")
pat = re.compile(r"wifi|iwl|iwx|80211|wpa|wlan|eapol|supplicant", re.I)
touching = 0
for h in heads:
    c, names = git("log", "--name-only", "--format=", "origin/main.." + h)
    n = sum(1 for l in names.splitlines() if pat.search(l))
    c, ahead = git("rev-list", "--count", "origin/main.." + h)
    pr = subprocess.run(["gh", "pr", "list", "--repo", "ToyOSOrg/ToyOS", "--head", h, "--state", "all",
                         "--json", "number", "--jq", "map(.number)|join(\",\")"], capture_output=True, text=True)
    print(m(f"{h}: commits past main {ahead.strip()}, Wi-Fi-named path lines {n}, pull requests [{pr.stdout.strip()}] (gh exit {pr.returncode})"))
    touching += n > 0
print(f"\nbranches touching a Wi-Fi-named path: {touching}")
c, wt = git("worktree", "list", "--porcelain")
wts = [l for l in wt.splitlines() if l.startswith("branch refs/heads/") and l[len("branch refs/heads/"):] in heads]
print(f"of them checked out as worktrees: {len(wts)}")

