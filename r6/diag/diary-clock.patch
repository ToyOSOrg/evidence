+/// Per CPU, the nanoseconds of `from..to` each process ran and the CPU idled,
+/// walked from the diary's picks and idle entries; and the events seen.
+#[cfg(target_os = "toyos")]
+fn window_diary(bench: &str, d: &mut crate::sys::diag::Diag, from: u64, to: u64) {
+    use toyos_trace::Event;
+    let (records, lost, failed) = d.diary();
+    let mut cpus: std::collections::BTreeMap<u16, Vec<(u64, Option<u32>, &'static str)>> = Default::default();
+    for (at, e) in &records {
+        let mark = match e.event {
+            Event::Pick => Some((e.thread.map(|t| t.pid), "pick")),
+            Event::IdleEnter => Some((None, "idle")),
+            _ => None,
+        };
+        if let Some((pid, what)) = mark {
+            cpus.entry(e.cpu).or_default().push((*at, pid, what));
+        }
+    }
+    for (cpu, marks) in cpus {
+        let mut by: std::collections::BTreeMap<String, u64> = Default::default();
+        let mut picks = 0u32;
+        let mut current: Option<(u64, String)> = None;
+        for &(at, pid, what) in marks.iter().chain(std::iter::once(&(to, None, "end"))) {
+            if let Some((since, who)) = current.take() {
+                let span = at.min(to).saturating_sub(since.max(from));
+                if at > from {
+                    *by.entry(who).or_default() += span;
+                }
+            }
+            if what == "pick" && (from..to).contains(&at) {
+                picks += 1;
+            }
+            current = match what {
+                "pick" => Some((at, pid.map_or("kernel".into(), |p| p.to_string()))),
+                "idle" => Some((at, "idle".into())),
+                _ => None,
+            };
+        }
+        let ran: Vec<String> = by.iter().filter(|(_, ns)| **ns > 0).map(|(who, ns)| format!("{who}:{}", ns / 1000)).collect();
+        report::note(
+            &format!("{bench}.diary"),
+            &[("cpu", cpu.to_string()), ("picks", picks.to_string()), ("us", ran.join(",")), ("lost", lost.to_string()), ("failed", failed.clone().unwrap_or_else(|| "no".into()))],
+        );
+    }
+}
