+/// Investigation probe: `dma_reach` on QEMU's two HDA controllers behind
+/// VT-d with `claim-floor=`, its lines printed for reading; the verdict is
+/// only that it ran.
+fn dma_reach_qemu_smoke() -> Result<(), String> {
+    const JOB: &str = "dma_reach";
+    let config = compile::repo_root().join("tests/images/dmareachcase.toml");
+    let tests = compile::repo_root().join("tests/guest/rust-tests");
+    let bins = [(JOB.to_string(), qemu::build_toyos_bin(qemu::SUITE_ARCH, &tests, JOB))];
+    let options = BootOptions {
+        profile: qemu::Profile::MetalTwoHda,
+        kernel_params: &["claim-floor=40000000"],
+        ..Default::default()
+    };
+    let mut qemu = QemuInstance::boot_with_options(&config, &[], &bins, options);
+    let boot = qemu.boot_log().to_string();
+    let console = format!("{boot}\n{}", job_window(&mut qemu, &format!("test_rs_{JOB}"))?);
+    for line in console.lines().filter(|l| l.contains("dma_reach") || l.contains("DMA FAULT") || l.contains("claim-floor")) {
+        eprintln!("  {line}");
+    }
+    if !console.contains("dma_reach: done") {
+        return Err(format!("the probe did not finish:\n{console}"));
+    }
+    Ok(())
+}
