--- /dev/null
+++ b/tests/guest/rust-tests/src/bin/dma_reach.rs
@@ -0,0 +1,278 @@
+//! Investigation probe, not a regression test: which device-address bits each
+//! HD Audio function of the AMD bench carries to the unit. Run on a boot armed
+//! `claim-floor=`, so a claim's grants sit below 4 GiB.
+//!
+//! Per function, each step on a claim of its own unless it reached nothing:
+//! the upper base registers written all-ones and read back; the codec link and
+//! an output stream at the grant; then the link aimed at the grant with one
+//! bit `k` above it set, from 63 down, until a step reaches nothing; the same
+//! for the stream; then two patterns over bits 32 to 47. A step that reaches
+//! nothing faults at the unit, whose `DMA FAULT` record names the address the
+//! function issued, and the claim refuses from then on. Every reading is
+//! printed; the exit is only whether the protocol ran.
+
+use std::time::{Duration, Instant};
+
+use toyos::endow::Endowments;
+use toyos::syscap::SysCap;
+use toyos::PciDev;
+use toyos_abi::inventory::{Pci, RawRecord, Record};
+use toyos_abi::syscall::{SyscallError, SYSCAP_LABEL};
+use toyos_device_memory::{DmaBuffers, Registers};
+use toyos_hda::controller::{self, Link, Stream, CODEC_DETECT_MICROS};
+use toyos_hda::probe;
+use toyos_hda::verb::{
+    Address, Node, Verb, GET_PARAMETER, PARAM_VENDOR_ID, SET_CONVERTER_FORMAT, SET_CONVERTER_STREAM, SET_POWER_STATE,
+};
+use toyos_pci_claim::{Bar, Grant};
+
+/// Every HD Audio function (class 04, subclass 03), the GPU's (vendor 1002)
+/// last: the bench's analogue function, which reaches the shipping layout,
+/// is the control.
+fn functions(cap: &SysCap) -> Vec<Pci> {
+    let records: Vec<Record> = cap.records(|n| vec![RawRecord::EMPTY; n]).expect("dma_reach: the inventory");
+    let mut hda: Vec<Pci> = records
+        .into_iter()
+        .filter_map(|record| match record {
+            Record::Pci(pci) if pci.class == 0x04 && pci.subclass == 0x03 => Some(pci),
+            _ => None,
+        })
+        .collect();
+    hda.sort_by_key(|pci| pci.vendor == 0x1002);
+    hda
+}
+
+const CORBUBASE: usize = 0x44;
+const RIRBUBASE: usize = 0x54;
+const DPLBASE: usize = 0x70;
+const DPUBASE: usize = 0x74;
+const SD_BASE: usize = 0x80;
+const SD_STRIDE: usize = 0x20;
+const SD_LPIB: usize = 0x04;
+const SD_STS: usize = 0x03;
+const SD_BDPU: usize = 0x1C;
+
+/// CORB, RIRB and BDL in the first page; the stream's cyclic buffer after
+/// it, and the position words after that (§3.3.32).
+const RING_AT: usize = 0x1000;
+const POSITIONS: usize = 0x2000;
+const BYTES: u64 = 0x3000;
+/// 48 kHz, two channels, 16 bits (HDA 1.0a §3.7.1).
+const FORMAT: u16 = 0x0011;
+/// The ring is 4 KiB, 21 ms at 192 kB/s: a stream that reaches its buffer has
+/// gone round it many times within this.
+const STREAM_BOUND: Duration = Duration::from_millis(500);
+
+/// A grant the device is told is at its own address with `alias` set.
+#[derive(Clone, Copy)]
+struct Aliased {
+    grant: Grant,
+    alias: u64,
+}
+
+impl DmaBuffers for Aliased {
+    fn bytes(&self) -> usize {
+        self.grant.bytes()
+    }
+    fn device_addr(&self, at: usize) -> u64 {
+        self.grant.device_addr(at) | self.alias
+    }
+    fn read16(&self, at: usize) -> u16 {
+        self.grant.read16(at)
+    }
+    fn read32(&self, at: usize) -> u32 {
+        self.grant.read32(at)
+    }
+    fn read64(&self, at: usize) -> u64 {
+        self.grant.read64(at)
+    }
+    fn write16(&self, at: usize, value: u16) {
+        self.grant.write16(at, value)
+    }
+    fn write32(&self, at: usize, value: u32) {
+        self.grant.write32(at, value)
+    }
+    fn write64(&self, at: usize, value: u64) {
+        self.grant.write64(at, value)
+    }
+    fn publish(&self) {
+        self.grant.publish()
+    }
+    fn observe(&self) {
+        self.grant.observe()
+    }
+}
+
+/// One claim, its registers and a grant.
+/// The mappings go before the claim, in field order.
+struct Held {
+    _keep: (toyos::shm::SharedMemory, toyos::DmaRegion),
+    dev: PciDev,
+    bar: Bar,
+    grant: Grant,
+}
+
+fn hold(cap: &SysCap, id: &Pci) -> Held {
+    let dev: PciDev = cap.claim_function(id.arrival).unwrap_or_else(|why| panic!("dma_reach: claim on {}: {why:?}", name(id)));
+    let info = toyos_pci_claim::describe(&dev).expect("dma_reach: describe");
+    let (bar, mapping) = Bar::map(&dev, 0, info.bar_bytes[0]).expect("dma_reach: BAR 0");
+    let (grant, region) = Grant::alloc(&dev, BYTES).expect("dma_reach: grant");
+    grant.window().zero();
+    Held { _keep: (mapping, region), dev, bar, grant }
+}
+
+fn name(pci: &Pci) -> String {
+    format!("{:02x}:{:02x}.{} [{:04x}:{:04x}]", pci.at.bus, pci.at.dev, pci.at.func, pci.vendor, pci.device)
+}
+
+fn try_reset(bar: &Bar) -> Result<controller::Reset, String> {
+    controller::reset(bar, || std::thread::sleep(Duration::from_micros(CODEC_DETECT_MICROS))).map_err(|why| format!("{why}"))
+}
+
+fn reset(bar: &Bar) -> controller::Reset {
+    try_reset(bar).unwrap_or_else(|why| panic!("dma_reach: reset: {why}"))
+}
+
+/// Whether the claim still answers, or the unit has refused it.
+fn alive(dev: &PciDev) -> bool {
+    !matches!(dev.irq(), Err(SyscallError::Io))
+}
+
+/// The codec link at `mem`, over a zeroed grant: the first codec's vendor id,
+/// which only a RIRB write that reached the grant puts there.
+fn link(bar: Bar, mem: Aliased) -> Result<u32, String> {
+    mem.grant.window().zero();
+    let reset = reset(&bar);
+    let mut link = Link::open(bar, mem, &reset).map_err(|why| format!("open: {why}"))?;
+    let codec = Address::new(reset.statests.trailing_zeros() as u8).expect("a codec address");
+    match link.send(Verb::short(codec, Node::ROOT, GET_PARAMETER, PARAM_VENDOR_ID)) {
+        Ok(0) => Err("answered 0, which nothing wrote".to_string()),
+        Ok(id) => Ok(id),
+        Err(why) => Err(format!("{why}")),
+    }
+}
+
+/// An output stream whose descriptor list, buffer and position word are at
+/// `mem`, the link at the grant itself configuring the first converter for
+/// it: how far its position went, where the position word says so too.
+fn stream(bar: Bar, mem: Aliased) -> Result<u32, String> {
+    mem.grant.window().zero();
+    let reset = reset(&bar);
+    let plain = Aliased { grant: mem.grant, alias: 0 };
+    let mut link = Link::open(bar, plain, &reset).map_err(|why| format!("link open: {why}"))?;
+    let codecs: Vec<_> = probe::enumerate(&mut link, reset.statests).into_iter().filter_map(Result::ok).collect();
+    let (codec, group, converter) = codecs
+        .iter()
+        .flat_map(|codec| codec.groups.iter().map(move |group| (codec, group)))
+        .find_map(|(codec, group)| group.widgets.iter().find(|w| w.is_converter()).map(|w| (codec.address, group.node, w.node)))
+        .ok_or("no converter on any codec")?;
+    for verb in [
+        Verb::short(codec, group, SET_POWER_STATE, 0),
+        Verb::short(codec, converter, SET_POWER_STATE, 0),
+        Verb::long(codec, converter, SET_CONVERTER_FORMAT as u8, FORMAT),
+        Verb::short(codec, converter, SET_CONVERTER_STREAM, controller::STREAM_TAG << 4),
+    ] {
+        link.send(verb).map_err(|why| format!("converter {converter:?}: {why}"))?;
+    }
+    let ring = mem.device_addr(RING_AT);
+    let mut stream = Stream::open(bar, &mem, ring, &reset, FORMAT).map_err(|why| format!("open: {why}"))?;
+    let index = reset.gcap.input_streams();
+    let at = SD_BASE + index * SD_STRIDE;
+    let position = mem.device_addr(POSITIONS);
+    bar.write32(DPUBASE, (position >> 32) as u32);
+    bar.write32(DPLBASE, position as u32 | 1);
+    stream.start().map_err(|why| format!("start: {why}"))?;
+    let began = Instant::now();
+    let (mut moved, mut written) = (0u32, 0u32);
+    let mut last = bar.read32(at + SD_LPIB);
+    while began.elapsed() < STREAM_BOUND && (moved < 8 * 4096 || written == 0) {
+        let now = bar.read32(at + SD_LPIB);
+        moved += now.wrapping_sub(last) % 4096;
+        last = now;
+        written = written.max(mem.grant.read32(POSITIONS + 8 * index));
+    }
+    let status = bar.read8(at + SD_STS);
+    let _ = stream.stop();
+    bar.write32(DPLBASE, 0);
+    if moved >= 8 * 4096 && written != 0 && status & 0x10 == 0 {
+        Ok(moved)
+    } else {
+        Err(format!(
+            "moved {moved} bytes in {STREAM_BOUND:?}, position word {written:#x}, SDnSTS {status:#04x}"
+        ))
+    }
+}
+
+type Step = fn(Bar, Aliased) -> Result<u32, String>;
+
+/// `step` at the grant with each alias of `aliases` in turn, on one claim,
+/// until one reaches nothing.
+fn ladder(cap: &SysCap, pci: &Pci, what: &str, step: Step, aliases: &[u64]) {
+    let id = name(pci);
+    let held = hold(cap, pci);
+    let base = held.grant.device_addr(0);
+    let mut first = None;
+    for &alias in aliases {
+        assert_eq!(base & alias, 0, "dma_reach: the grant at {base:#x} already carries {alias:#x}");
+        let mem = Aliased { grant: held.grant, alias };
+        let told = mem.device_addr(0);
+        let result = step(held.bar, mem).and_then(|answer| match first {
+            Some(was) if what == "link" && was != answer => Err(format!("answered {answer:#x}, not {was:#x}")),
+            _ => Ok(answer),
+        });
+        match result {
+            Ok(answer) => {
+                first.get_or_insert(answer);
+                println!("dma_reach: {id} {what} told {told:#x} (alias {alias:#x}): reached, {answer:#x}");
+            }
+            Err(why) => {
+                let refused = !alive(&held.dev);
+                println!(
+                    "dma_reach: {id} {what} told {told:#x} (alias {alias:#x}): reached nothing ({why}); \
+                     claim refused={refused}"
+                );
+                return;
+            }
+        }
+    }
+}
+
+/// Whether the function has a codec to answer the link's verbs.
+fn registers(cap: &SysCap, pci: &Pci) -> bool {
+    let id = name(pci);
+    let held = hold(cap, pci);
+    let reset = match try_reset(&held.bar) {
+        Ok(reset) => reset,
+        Err(why) => {
+            println!("dma_reach: {id} skipped: {why}");
+            return false;
+        }
+    };
+    println!("dma_reach: {id} gcap={:#06x} statests={:#06x} grant at {:#x}", reset.gcap.0, reset.statests, held.grant.device_addr(0));
+    let sd = SD_BASE + reset.gcap.input_streams() * SD_STRIDE + SD_BDPU;
+    for (reg, at) in [("CORBUBASE", CORBUBASE), ("RIRBUBASE", RIRBUBASE), ("DPUBASE", DPUBASE), ("SDnBDPU", sd)] {
+        held.bar.write32(at, u32::MAX);
+        let read = held.bar.read32(at);
+        held.bar.write32(at, 0);
+        println!("dma_reach: {id} {reg} written 0xffffffff reads {read:#010x}");
+    }
+    true
+}
+
+fn main() {
+    let cap: SysCap = Endowments::get().take(SYSCAP_LABEL).expect("dma_reach: a device-minting capability");
+    let bits: Vec<u64> = (32..64).rev().map(|k| 1u64 << k).collect();
+    let mut first: Vec<u64> = vec![0];
+    first.extend(&bits);
+    for pci in functions(&cap) {
+        if !registers(&cap, &pci) {
+            continue;
+        }
+        ladder(&cap, &pci, "link", link, &first);
+        ladder(&cap, &pci, "stream", stream, &first);
+        ladder(&cap, &pci, "link", link, &[0x5555 << 32]);
+        ladder(&cap, &pci, "link", link, &[0xAAAA << 32]);
+        ladder(&cap, &pci, "link", link, &[0xFFFF_0000 << 32]);
+    }
+    println!("dma_reach: done");
+}
