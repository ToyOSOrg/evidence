@@ -317,7 +317,30 @@ static UNSHOWN: AtomicU64 = AtomicU64::new(0);
 /// One console holder's line, or a piece of one it `continues` in the next,
 /// for `klogd` to put on the wire; `false` is a full queue, which the holder's
 /// write answers as bytes it did not take. Never waits.
+// DIAG (temporary, never committed): the earliest program lines about storage
+// and the log, kept for the black box.
+pub static DIAG: Lock<(usize, [u8; 7168])> = Lock::new((0, [0; 7168]));
+const DIAG_WORDS: &[&[u8]] = &[b"usbd", b"diskserver", b"fileserver", b"logkeeper", b"supervisor", b"===TEST_", b"panic", b"rror", b"refus"];
+fn diag_keep(line: &[u8]) {
+    if !DIAG_WORDS.iter().any(|w| line.windows(w.len()).any(|x| x == *w)) {
+        return;
+    }
+    let mut d = DIAG.lock();
+    let (len, buf) = &mut *d;
+    let n = line.len().min(200);
+    if *len + n + 1 > buf.len() {
+        return;
+    }
+    buf[*len..*len + n].copy_from_slice(&line[..n]);
+    *len += n;
+    if line[..n].last() != Some(&b'\n') {
+        buf[*len] = b'\n';
+        *len += 1;
+    }
+}
