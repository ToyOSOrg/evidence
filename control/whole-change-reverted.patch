-        .ok_or("the kernel's section headers lie outside it")?;
-    let sections: Vec<SectionHeader> = SectionTable::new(table)
-        .iter()
-        .filter(|s| s.kind == SHT_PROGBITS && s.flags & SHF_EXECINSTR != 0)
