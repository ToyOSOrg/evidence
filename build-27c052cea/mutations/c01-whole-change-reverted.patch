-            }
-        }
-    }
-
-    /// A write, feeding what was waiting before it to the decoders.
-    fn send(
-        &mut self,
-        c: &mut impl Controller,
-        port: Port,
-        byte: u8,
-        deadline: u64,
-        out: &mut Vec<Record>,
-        say: &mut dyn FnMut(String),
-    ) -> Result<(), NotTaken> {
