+fn scratch_measure_system() -> Result<(), String> {
+    let mut qemu = QemuInstance::boot_with_options(&compile::repo_root().join("images/system.toml"), &[], &[], BootOptions { profile: qemu::Profile::Metal, qmp: true, ..Default::default() });
+    let mut console = format!("{}\n", qemu.boot_log());
+    await_marker(&mut qemu, &mut console, "compositor: ready", "the compositor")?;
+    await_marker(&mut qemu, &mut console, ps2server::ARMED_BOTH, "ps2server")?;
+    let press = |qemu: &QemuInstance, chord: &[&str]| { let mut input = qemu::QmpInput::open(qemu.qmp_socket()); input.keys(&chord.iter().map(|k| (*k, true)).collect::<Vec<_>>()); input.keys(&chord.iter().rev().map(|k| (*k, false)).collect::<Vec<_>>()); };
+    for _ in 0..4 {
+        let from = console.len();
+        press(&qemu, &["ctrl", "n"]);
+        await_marker_new(&mut qemu, &mut console, "terminal: ready", from, "a terminal")?;
+        for key in ["l", "s", "ret"] { press(&qemu, &[key]); }
+        await_marker_new(&mut qemu, &mut console, "spawn: /system/bin/ls", from, "ls")?;
+    }
+    for line in console.lines().filter(|l| l.contains("FLOOR-MEASURE")) { eprintln!("{line}"); }
+    Ok(())
+}
