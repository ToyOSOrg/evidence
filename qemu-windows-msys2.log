===== msys2.sh
#!/bin/bash
# The Windows build QEMU's download page names beside Stefan Weil's installers:
# MSYS2's UCRT64 package, read as bytes and never run.
# Usage: msys2.sh <download dir> <extract dir> <log>
dl="$1"; x="$2"; log="$3"
pkg=mingw-w64-ucrt-x86_64-qemu-11.1.2-1-any.pkg.tar.zst
{
echo "\$ curl -A 'toyos-build (https://github.com/ToyOSOrg/ToyOS)' -O https://repo.msys2.org/mingw/ucrt64/$pkg"
echo "(fetched before this log; its digest:)"
echo "\$ shasum -a 256 $pkg"; (cd "$dl" && shasum -a 256 "$pkg"); echo "EXIT=$?"; echo
echo "\$ zstd -d $pkg -o pkg.tar && tar -xf pkg.tar .PKGINFO .BUILDINFO ucrt64/bin/qemu-system-x86_64.exe ucrt64/bin/qemu-system-aarch64.exe"
rm -rf "$x" && mkdir -p "$x" && zstd -d -q -f "$dl/$pkg" -o "$x/pkg.tar" && (cd "$x" && tar -xf pkg.tar .PKGINFO .BUILDINFO ucrt64/bin/qemu-system-x86_64.exe ucrt64/bin/qemu-system-aarch64.exe); echo "EXIT=$?"; echo
echo "\$ grep -E '^(pkgname|pkgver|packager) |^depend = .*-(spice|gtk3)$' .PKGINFO"
(cd "$x" && grep -E '^(pkgname|pkgver|packager) |^depend = .*-(spice|gtk3)$' .PKGINFO); echo "EXIT=$?"; echo
echo "\$ grep -E '^installed = .*-(spice|spice-protocol|gtk3)-[0-9]' .BUILDINFO"
(cd "$x" && grep -E '^installed = .*-(spice|spice-protocol|gtk3)-[0-9]' .BUILDINFO); echo "EXIT=$?"; echo
for b in qemu-system-x86_64.exe qemu-system-aarch64.exe; do
  echo "\$ shasum -a 256 ucrt64/bin/$b"; (cd "$x" && shasum -a 256 "ucrt64/bin/$b"); echo "EXIT=$?"; echo
  echo "\$ LC_ALL=C grep -a -o -e chardev-qemu-vdagent -e 'buffer full, dropping message' -e clipboard-grab-serial -e 'Failed to set GTK clipboard' -e gtk_clipboard_request_text ucrt64/bin/$b | sort | uniq -c"
  (cd "$x" && LC_ALL=C grep -a -o -e chardev-qemu-vdagent -e 'buffer full, dropping message' -e clipboard-grab-serial -e 'Failed to set GTK clipboard' -e gtk_clipboard_request_text "ucrt64/bin/$b" | sort | uniq -c); echo "EXIT=${PIPESTATUS[0]}"; echo
done
} > "$log" 2>&1
