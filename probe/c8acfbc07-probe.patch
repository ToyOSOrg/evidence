+# The `dma_reach` probe's boot: `jobcase.toml`'s shape with no `hda`, so the
+# probe's claims on the HD Audio functions are the only ones, and the
+# inventory and device authority it claims them with.
+[boot]
+start = ["logkeeper", "diskserver", "fileserver", "test-runner"]
+
+[programs.logkeeper]
+service = true
+syscap = ["logread"]
+
+[programs.test-runner]
+receives = ["power"]
+syscap = ["device", "dup", "inventory"]
+
+[programs.toybox]
+
+[symlinks]
+"bin/reboot" = "/system/bin/toybox"
+
+[programs.diskserver]
+service = true
+restart = true
+serves = ["block"]
+devices = ["pci:01:08:02/1b36:0010"]
+
+[programs.fileserver]
+restart = true
+roles = ["data", "log", "boot"]
+receives = ["block"]
