+/// SCOUT (never committed): what each CPU's last timer interrupt found, and the
+/// UART's last write, for a report written once the console has been silent.
+#[cfg(not(feature = "loom"))]
+pub mod stall {
+    use core::fmt::Write;
+    use core::sync::atomic::{AtomicBool, AtomicU64, Ordering::Relaxed};
+
+    pub static PC: [AtomicU64; 64] = [const { AtomicU64::new(0) }; 64];
+    pub static AT: [AtomicU64; 64] = [const { AtomicU64::new(0) }; 64];
+    pub static EL0: [AtomicU64; 64] = [const { AtomicU64::new(0) }; 64];
+    pub static IDLE_IN: [AtomicU64; 64] = [const { AtomicU64::new(0) }; 64];
+    pub static IDLE_OUT: [AtomicU64; 64] = [const { AtomicU64::new(0) }; 64];
+    pub static LAST_TX: AtomicU64 = AtomicU64::new(0);
+    static SAID: AtomicBool = AtomicBool::new(false);
+
+    struct Line { b: [u8; 240], n: usize }
+    impl Write for Line {
+        fn write_str(&mut self, s: &str) -> core::fmt::Result {
+            for &c in s.as_bytes() {
+                if self.n < self.b.len() { self.b[self.n] = c; self.n += 1; }
+            }
+            Ok(())
+        }
+    }
+
+    fn say(args: core::fmt::Arguments<'_>) {
+        let mut line = Line { b: [0; 240], n: 0 };
+        let _ = line.write_fmt(args);
+        let _ = line.write_str("\n");
+        let mut g = crate::drivers::serial::BackendGuard::lock();
+        g.write_raw(&line.b[..line.n]);
+    }
+
+    /// Every timer interrupt: note where it landed, and report once past 4 s of silence.
+    pub fn tick(pc: u64, el0: bool) {
+        let cpu = crate::arch::percpu::cpu_id() as usize;
+        let now = crate::clock::nanos_since_boot();
+        PC[cpu].store(pc, Relaxed);
+        AT[cpu].store(now, Relaxed);
+        EL0[cpu].store(el0 as u64, Relaxed);
+        let last = LAST_TX.load(Relaxed);
+        if last == 0 || now.saturating_sub(last) < 4_000_000_000 || SAID.swap(true, Relaxed) {
+            return;
+        }
+        say(format_args!("SCOUT-STALL cpu{cpu} at {now}: the UART last wrote at {last}; klogd {:?}", crate::log::console::scout_klogd()));
+        for c in 0..crate::smp::cpu_count() as usize {
+            let pc = PC[c].load(Relaxed);
+            let sym = crate::symbols::kernel_symbol(pc);
+            let (name, off) = sym.unwrap_or(("?", 0));
+            say(format_args!(
+                "SCOUT-STALL cpu{c}: tick at {} pc {pc:#x} {name}+{off:#x} el0={} idle in {} out {} held {}",
+                AT[c].load(Relaxed), EL0[c].load(Relaxed), IDLE_IN[c].load(Relaxed), IDLE_OUT[c].load(Relaxed),
+                super::SCOUT_HELD[c].load(Relaxed),
+            ));
+        }
+        crate::hw::scout_contexts(say);
+    }
+}
