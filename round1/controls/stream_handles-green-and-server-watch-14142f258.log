diff --git a/sdk/toyos/src/net/stream.rs b/sdk/toyos/src/net/stream.rs
index 0521c1a45..f9c90e59e 100644
--- a/sdk/toyos/src/net/stream.rs
+++ b/sdk/toyos/src/net/stream.rs
@@ -77,7 +77,8 @@ pub type Server = session::Server<RECEIVE_BYTES, SEND_BYTES, WORDS>;
 /// What netstack watches a stream's connection for: the client's rings, and
 /// its hang-up, which the connection reads as its end. A connection is no pipe
 /// end, so the kernel refuses it `OTHER_END_GONE`.
-pub const SERVER_WATCH: u32 = crate::poller::READABLE;
+// Control: the watch netstack made before, which asks the hang-up as OTHER_END_GONE.
+pub const SERVER_WATCH: u32 = crate::poller::READABLE | crate::poller::OTHER_END_GONE;
 
 /// The receive ring's `end`: the peer's reset, or netstack's own.
 pub const RESET: u32 = 2;
