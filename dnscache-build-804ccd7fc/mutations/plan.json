[
 {
  "id": "m01-view-ignored",
  "what": "the cache keyed by name alone, ignoring the view",
  "tests": [
   [
    "-p",
    "toyos-dns",
    "tests::a_view_is_never_answered_from_another_views_entry"
   ],
   [
    "-p",
    "toyos-net-node --test resolve",
    "the_same_name_for_another_view_sends_its_own_query"
   ]
  ]
 },
 {
  "id": "m02-largest-ttl",
  "what": "the least TTL taken as the largest",
  "tests": [
   [
    "-p",
    "toyos-dns",
    "tests::rfc2181_5_2_an_answer_is_kept_for_the_least_ttl_of_its_aliases_and_its_differing_addresses"
   ]
  ]
 },
 {
  "id": "m03-last-send",
  "what": "every reply's TTLs counted from the last query's send",
  "tests": [
   [
    "-p",
    "toyos-dns",
    "tests::every_ttl_counts_from_the_first_querys_send_across_an_alias_asked_again"
   ],
   [
    "-p",
    "toyos-dns",
    "tests::every_ttl_counts_from_the_first_querys_send_across_a_query_sent_again"
   ]
  ]
 },
 {
  "id": "m04-setter-keeps",
  "what": "the emptying taken out of the lease setter",
  "tests": [
   [
    "-p",
    "toyos-net-node --test resolve",
    "a_lease_lost_and_another_naming_the_same_resolver_empty_what_every_view_keeps"
   ],
   [
    "-p",
    "toyos-net-node --test resolve",
    "a_renewal_with_the_same_terms_empties_what_every_view_keeps"
   ]
  ]
 },
 {
  "id": "m05-link-keeps",
  "what": "the emptying taken out of Stack::link",
  "tests": [
   [
    "-p",
    "toyos-net-node --test resolve",
    "a_link_that_goes_down_empties_what_every_view_keeps_though_the_lease_stays"
   ]
  ]
 },
 {
  "id": "m06-no-generation",
  "what": "the generation check taken out of the keep",
  "tests": [
   [
    "-p",
    "toyos-dns",
    "tests::the_answer_of_a_lookup_started_before_an_emptying_is_not_kept"
   ],
   [
    "-p",
    "toyos-net-node --test resolve",
    "a_lookup_in_flight_as_the_link_goes_down_is_answered_and_keeps_nothing"
   ]
  ]
 },
 {
  "id": "m07-no-expired-view-first",
  "what": "the expired view no longer preferred over the least recently used one",
  "tests": [
   [
    "-p",
    "toyos-dns",
    "tests::a_new_view_replaces_one_whose_entries_have_all_expired_before_a_live_one"
   ]
  ]
 },
 {
  "id": "m08-alias-target-kept",
  "what": "an alias target kept under its own name",
  "tests": [
   [
    "-p",
    "toyos-net-node --test resolve",
    "nothing_is_kept_under_a_name_the_view_did_not_ask"
   ]
  ]
 },
 {
  "id": "m09-soa-any-zone",
  "what": "an SOA accepted from outside the denied name's ancestry",
  "tests": [
   [
    "-p",
    "toyos-dns",
    "tests::rfc2308_5_an_absence_with_no_soa_or_with_one_outside_the_denied_names_zone_keeps_nothing"
   ]
  ]
 },
 {
  "id": "m10-hit-holds-a-place",
  "what": "a kept answer asked only once a lookup place is free",
  "tests": [
   [
    "-p",
    "toyos-net-node --test resolve",
    "a_kept_answer_is_given_while_every_lookup_place_is_held"
   ]
  ]
 },
 {
  "id": "m11-no-expired-entry-first",
  "what": "a full view's expired entries no longer dropped before its least recently used",
  "tests": [
   [
    "-p",
    "toyos-dns",
    "tests::a_full_view_drops_its_expired_entries_before_a_live_one"
   ]
  ]
 },
 {
  "id": "m12-zero-ttl-kept",
  "what": "a TTL of zero given a deadline",
  "tests": [
   [
    "-p",
    "toyos-dns",
    "tests::rfc1035_4_1_3_a_ttl_of_zero_anywhere_in_what_was_read_keeps_nothing"
   ]
  ]
 },
 {
  "id": "m13-msb-as-zero",
  "what": "a TTL with its high-order bit set read as zero (RFC 2181 \u00a78's reading)",
  "tests": [
   [
    "-p",
    "toyos-dns",
    "tests::rfc8767_4_a_ttl_is_read_unsigned_and_kept_an_hour_at_most"
   ]
  ]
 },
 {
  "id": "m14-no-cap",
  "what": "the one-hour cap taken off",
  "tests": [
   [
    "-p",
    "toyos-dns",
    "tests::rfc8767_4_a_ttl_is_read_unsigned_and_kept_an_hour_at_most"
   ]
  ]
 },
 {
  "id": "m15-soa-ttl-not-minimum",
  "what": "an absence kept for its SOA's TTL alone, its MINIMUM not read",
  "tests": [
   [
    "-p",
    "toyos-dns",
    "tests::rfc2308_5_an_absence_is_kept_for_the_least_of_its_soas_ttl_and_minimum_and_of_its_aliases"
   ]
  ]
 },
 {
  "id": "m16-failure-kept",
  "what": "a failure kept",
  "tests": [
   [
    "-p",
    "toyos-dns",
    "tests::a_failure_is_never_kept_and_an_absence_is"
   ]
  ]
 },
 {
  "id": "m17-full-view-drops-another",
  "what": "a full view drops the least recently used view's oldest entry",
  "tests": [
   [
    "-p",
    "toyos-dns",
    "tests::a_full_view_drops_its_own_least_recently_used_entry_and_no_other_views"
   ]
  ]
 },
 {
  "id": "m18-deadline-inclusive",
  "what": "an answer given at its deadline",
  "tests": [
   [
    "-p",
    "toyos-dns",
    "tests::an_answer_is_given_before_its_deadline_and_not_at_it"
   ]
  ]
 }
]