+    fn scalars() -> std::vec::Vec<[u8; 32]> {
+        let mut out = std::vec![[0; 32], [0x88; 32], [0x77; 32], [0xff; 32]];
+        for a in &mut out {
+            a[31] &= 0x7f;
+        }
+        let mut seed = 0x2545f4914f6cdd1du64;
+        for _ in 0..60 {
+            let mut a = [0u8; 32];
+            for byte in &mut a {
+                seed ^= seed << 13;
+                seed ^= seed >> 7;
+                seed ^= seed << 17;
+                *byte = seed as u8;
+            }
+            a[31] &= 0x7f;
+            out.push(a);
+        }
+        out
+    }
