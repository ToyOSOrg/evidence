+                .iter()
+                .filter(|bridge| bridge.leads_to(bus))
+                .all(|bridge| bridge.forwards(at, at + span, prefetchable));
+            if routed && first.is_none_or(|(held, _)| at < held) {
+                first = Some((at, base));
+            }
+        }
+    }
