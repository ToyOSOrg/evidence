# A reading of #876's similarity check (§7.7) over code whose provenance is known.
#
#   green arm: commits of ToyOS's own wired networking, written without the Wi-Fi references;
#              a rule that is an oracle reads zero over each.
#   red arm:   the demo's delta past its merge base with main, Rust written by an agent that read
#              the references; a rule that sees name-level carry-over reads it red. Counts only:
#              nothing of what matched is printed.
#
# The rule, every part of it a flag:
#   --norm r2       round 2's normalisation: identifiers split at underscores, case changes and
#                   digit runs into lower-case tokens, digit runs and single letters included.
#   --norm alpha2   round 3's: the same split, keeping only alphabetic tokens of two or more letters.
#   --min-id N      an identifier is a candidate at N or more tokens.
#   --min-str N     a string literal is a candidate at N or more words (words split as identifiers).
#   --run N         every run of N consecutive comment words is a candidate.
#   --background D  a candidate occurring in the pinned corpus under D (D/linux C, D/smoltcp Rust),
#                   same-domain code outside the reference set, is no hit; "none" for no exemption.
#
# A candidate "occurs" in a text where its token sequence occurs contiguously inside one unit
# there: one identifier, one string literal, one comment block (consecutive line comments are one
# block). Numeric literals are skipped, never read as identifiers. A candidate is a hit where it
# occurs in the reference set, not in the tree at the diff's base, and not in the background.
# Not modelled, each of which could only lower a count: the standards exemption (no standard is
# on this host) and the list of public names.
#
# argv: --refs D --repo R --demo B [rule flags] green <commit>... | red
import argparse
import collections
import os
import re
import subprocess
import sys

ap = argparse.ArgumentParser()
ap.add_argument('--refs', required=True)
ap.add_argument('--repo', required=True)
ap.add_argument('--demo', required=True)
ap.add_argument('--norm', choices=('r2', 'alpha2'), required=True)
ap.add_argument('--min-id', type=int, required=True)
ap.add_argument('--min-str', type=int, required=True)
ap.add_argument('--run', type=int, required=True)
ap.add_argument('--background', required=True)
ap.add_argument('arm', choices=('green', 'red'))
ap.add_argument('commits', nargs='*')
a = ap.parse_args()

IDENT = re.compile(r'[A-Za-z_][A-Za-z0-9_]*')
SPLIT = re.compile(r'[A-Z]+(?=[A-Z][a-z])|[A-Z]?[a-z]+|[A-Z]+|[0-9]+')
WORD = re.compile(r'[A-Za-z0-9_]+')
CODE = ('.rs', '.c', '.h', '.cc', '.cpp', '.S', '.s')
PROSE = ('.md', '.txt', '.toml')


def split_ident(s):
    toks = SPLIT.findall(s)
    if a.norm == 'alpha2':
        toks = [t for t in toks if t.isalpha() and len(t) >= 2]
    return tuple(t.lower() for t in toks)


def words(text):
    out = []
    for w in WORD.findall(text):
        out.extend(split_ident(w))
    return tuple(out)


def lex(src):
    """Identifiers, string literals and comment blocks of C or Rust source."""
    idents, strings, comments = [], [], []
    i, n = 0, len(src)
    block = []
    last_comment_line = -2
    line_no = 0
    while i < n:
        c = src[i]
        if c == '\n':
            line_no += 1
            i += 1
            continue
        if src.startswith('//', i):
            j = src.find('\n', i)
            j = n if j < 0 else j
            text = src[i + 2:j]
            if last_comment_line == line_no - 1 and block:
                block.append(text)
            else:
                if block:
                    comments.append(' '.join(block))
                block = [text]
            last_comment_line = line_no
            i = j
            continue
        if src.startswith('/*', i):
            j = src.find('*/', i + 2)
            j = n if j < 0 else j
            if block:
                comments.append(' '.join(block))
                block = []
            comments.append(src[i + 2:j])
            line_no += src.count('\n', i, j)
            i = j + 2
            continue
        raw = None
        if c == 'r' and (i == 0 or not (src[i - 1].isalnum() or src[i - 1] == '_')):
            raw = re.match(r'r(#*)"', src[i:i + 8])
        if raw:
            close = '"' + raw.group(1)
            j = src.find(close, i + len(raw.group(0)))
            j = n if j < 0 else j
            strings.append(src[i + len(raw.group(0)):j])
            line_no += src.count('\n', i, j)
            i = j + len(close)
            continue
        if c == '"':
            j = i + 1
            while j < n and src[j] != '"':
                j += 2 if src[j] == '\\' else 1
            strings.append(src[i + 1:j])
            line_no += src.count('\n', i, j)
            i = j + 1
            continue
        if c == "'":
            m = re.match(r"'(\\.[^']{0,8}|[^'\\])'", src[i:i + 12])
            i += len(m.group(0)) if m else 1
            continue
        if c.isdigit():
            m = re.match(r'[0-9][0-9A-Za-z_.]*', src[i:i + 64])
            i += len(m.group(0))
            continue
        m = IDENT.match(src, i)
        if m:
            idents.append(m.group(0))
            i = m.end()
            continue
        i += 1
    if block:
        comments.append(' '.join(block))
    return idents, strings, comments


def units_of(path, text):
    if path.endswith(CODE):
        idents, strings, comments = lex(text)
        return [split_ident(x) for x in idents] + [words(s) for s in strings] + [words(c) for c in comments]
    if path.endswith(PROSE):
        return [words(text)]
    return []


def candidates_of(text):
    idents, strings, comments = lex(text)
    c = collections.defaultdict(set)
    for x in idents:
        t = split_ident(x)
        if len(t) >= a.min_id:
            c['identifier'].add(t)
    for s in strings:
        t = words(s)
        if len(t) >= a.min_str:
            c['string'].add(t)
    for b in comments:
        t = words(b)
        for k in range(0, len(t) - a.run + 1):
            c['comment'].add(t[k:k + a.run])
    return c


class Matcher:
    """Which of a set of token tuples occur contiguously inside the units fed to it."""

    def __init__(self, wanted):
        self.by_len = collections.defaultdict(set)
        for t in wanted:
            self.by_len[len(t)].add(t)
        self.firsts = {t[0] for t in wanted if t}
        self.lens = sorted(self.by_len)
        self.found = set()

    def feed(self, unit):
        n = len(unit)
        for p in range(n):
            if unit[p] not in self.firsts:
                continue
            for L in self.lens:
                if p + L > n:
                    break
                s = unit[p:p + L]
                if s in self.by_len[L]:
                    self.found.add(s)


def walk_files(root, suffixes):
    for d, dirs, names in os.walk(root):
        dirs[:] = [x for x in dirs if x != '.git']
        for name in names:
            if name.endswith(suffixes):
                p = os.path.join(d, name)
                yield p, open(p, 'rb').read().decode('utf-8', 'replace')


def git(*args):
    return subprocess.run(['git', '-C', a.repo, *args], capture_output=True, check=True).stdout


def tree_files(rev):
    listing = git('ls-tree', '-r', '-z', rev).split(b'\0')
    wanted = []
    for entry in listing:
        if not entry:
            continue
        meta, path = entry.split(b'\t', 1)
        _, kind, oid = meta.split()
        p = path.decode('utf-8', 'replace')
        if kind == b'blob' and p.endswith(CODE + PROSE):
            wanted.append((p, oid.decode()))
    proc = subprocess.Popen(['git', '-C', a.repo, 'cat-file', '--batch'], stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    proc.stdin.write(''.join(o + '\n' for _, o in wanted).encode())
    proc.stdin.close()
    for p, _ in wanted:
        size = int(proc.stdout.readline().split()[2])
        data = proc.stdout.read(size)
        proc.stdout.read(1)
        yield p, data.decode('utf-8', 'replace')
    proc.wait()


def added_text(base, head, pathspec):
    out = git('diff', '--unified=0', '--no-color', base, head, '--', *pathspec).decode('utf-8', 'replace')
    files = collections.defaultdict(list)
    cur = None
    for line in out.splitlines():
        if line.startswith('+++ '):
            cur = line[6:] if line.startswith('+++ b/') else None
        elif line.startswith('+') and cur is not None:
            files[cur].append(line[1:])
    return {p: '\n'.join(ls) for p, ls in files.items()}


def found_in(wanted, sources):
    m = Matcher(wanted)
    for path, text in sources:
        for u in units_of(path, text):
            m.feed(u)
    return m.found


REF_PARTS = {
    'openbsd': (os.path.join(a.refs, 'openbsd'), ('.c', '.h')),
    'linux': (os.path.join(a.refs, 'linux'), ('.c', '.h')),
    'hostap': (os.path.join(a.refs, 'hostap'), ('.c', '.h')),
}


def background(wanted):
    if a.background == 'none':
        return set()
    srcs = []
    srcs.append(walk_files(os.path.join(a.background, 'linux'), ('.c', '.h')))
    srcs.append(walk_files(os.path.join(a.background, 'smoltcp'), ('.rs',)))
    out = set()
    for s in srcs:
        out |= found_in(wanted, s)
    return out


print(f'rule: norm={a.norm} identifier>={a.min_id} tokens, string>={a.min_str} words, comment run={a.run} words, '
      f'background={"none" if a.background == "none" else "linux+smoltcp"}; one hit is red')
mb = git('merge-base', a.demo, 'origin/main').decode().strip()

if a.arm == 'green':
    per_commit = {}
    for c in a.commits:
        cands = collections.defaultdict(set)
        for _, text in added_text(c + '^', c, ['*.rs']).items():
            for cls, s in candidates_of(text).items():
                cands[cls] |= s
        per_commit[c] = cands
    everything = set()
    for cands in per_commit.values():
        for s in cands.values():
            everything |= s
    in_part = {g: found_in(everything, walk_files(root, sfx)) for g, (root, sfx) in REF_PARTS.items()}
    # The demo is part of the reference set: its delta, less what main held at its merge base.
    demo_found = found_in(everything, added_text(mb, a.demo, []).items())
    in_part['demo'] = demo_found - found_in(demo_found, tree_files(mb))
    red = 0
    for c in a.commits:
        cands = per_commit[c]
        allc = set().union(*cands.values()) if cands else set()
        raw = {t for t in allc if any(t in f for f in in_part.values())}
        past_base = raw - found_in(raw, tree_files(c + '^'))
        hits = past_base - background(past_base)
        subject = git('log', '-1', '--format=%s', c).decode().strip()
        print(f'== {c[:12]} {subject}')
        for cls in ('identifier', 'string', 'comment'):
            s = cands.get(cls, set())
            print(f'  {cls:10s} candidates {len(s):6d}  in the reference set {len(s & raw):5d}  '
                  f'past the base {len(s & past_base):5d}  hits {len(s & hits):5d}')
        print(f'  hits: {len(hits)}')
        for t in sorted(hits, key=lambda t: (len(t), t)):
            cls = next(k for k in ('identifier', 'string', 'comment') if t in cands.get(k, ()))
            parts = ','.join(g for g, f in in_part.items() if t in f)
            print(f'    [{cls}] {" ".join(t)}   ({parts})')
        red += len(hits) > 0
    print(f'green arm: commits the rule reads red: {red} of {len(a.commits)}')
else:
    wifi = re.compile(r'wifi|wlan|80211|wpa|eapol|ax2|iwl|iwx|supplicant', re.I)
    files = added_text(mb, a.demo, ['*.rs'])
    per_file = {}
    for p, text in files.items():
        per_file[p] = candidates_of(text)
    everything = set()
    for cands in per_file.values():
        for s in cands.values():
            everything |= s
    in_part = {g: found_in(everything, walk_files(root, sfx)) for g, (root, sfx) in REF_PARTS.items()}
    raw = {t for t in everything if any(t in f for f in in_part.values())}
    past_base = raw - found_in(raw, tree_files(mb))
    hits = past_base - background(past_base)
    print(f'== red arm: the demo branch past merge base {mb[:12]}, {len(files)} Rust files with added lines, '
          f'{sum(1 for p in files if wifi.search(p))} of them on a Wi-Fi-named path')
    for cls in ('identifier', 'string', 'comment'):
        s = set()
        for cands in per_file.values():
            s |= cands.get(cls, set())
        print(f'  {cls:10s} candidates {len(s):6d}  in the reference set {len(s & raw):5d}  '
              f'past the base {len(s & past_base):5d}  hits {len(s & hits):5d}')
    by_part = collections.Counter()
    for t in hits:
        for g, f in in_part.items():
            if t in f:
                by_part[g] += 1
    print(f'  hits by reference part (a hit may sit in several): {dict(sorted(by_part.items()))}')
    hit_files = [p for p, cands in per_file.items() if any(t in hits for s in cands.values() for t in s)]
    print(f'  files with a hit: {len(hit_files)}, of them on a Wi-Fi-named path: {sum(1 for p in hit_files if wifi.search(p))}')
    print(f'  hits: {len(hits)}')
    print(f'red arm: the rule reads the demo {"red" if hits else "GREEN"}')
sys.exit(0)

$ cat tools/drive.py
# Runs simcheck.py once per named variant, in parallel, each into logs/<prefix>-<name>.txt with
# its command line first and its own exit code last.
# argv: <prefix> <arm> <commits file or -> <name>=<flags> ...
import subprocess
import sys

prefix, arm, commits_file = sys.argv[1], sys.argv[2], sys.argv[3]
variants = [v.split('=', 1) for v in sys.argv[4:]]
commits = [] if commits_file == '-' else open(commits_file).read().split()
common = ['--refs', 'refs', '--repo', '<primary>', '--demo', 'wt/toyos-<bench>-wifi']
procs = []
for name, flags in variants:
    cmd = ['python3', '-I', 'tools/simcheck.py', *common, *flags.split(), arm, *commits]
    out = open(f'logs/{prefix}-{name}.txt', 'w')
    shown = ' '.join(cmd[:-len(commits)] if commits else cmd)
    out.write(f'$ {shown}' + (f' <the commits in {commits_file}>' if commits else '') + '\n')
    out.flush()
    procs.append((name, out, subprocess.Popen(cmd, stdout=out, stderr=subprocess.STDOUT)))
for name, out, p in procs:
    code = p.wait()
    out.write(f'EXIT={code}\n')
    out.close()
    print(f'{prefix}-{name}: EXIT={code}')

