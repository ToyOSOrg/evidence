+/// SCOUT (never committed): each CPU's context, through `say`.
+pub fn scout_contexts(say: fn(core::fmt::Arguments<'_>)) {
+    for cpu in 0..crate::smp::cpu_count() as usize {
+        let held = crate::cpu_local::get(cpu as u32).map_or(0, |local| local.hw.running_ctx.load(Relaxed));
+        if !crate::mm::is_kernel_addr(held) || !held.is_multiple_of(8) {
+            say(format_args!("SCOUT-STALL cpu{cpu} ctx {held:#x}"));
+            continue;
+        }
+        // SAFETY: a pointer `Hw::switch` stored, into the always-mapped direct map.
+        let ctx = unsafe { &*(held as *const KernelCtx) };
+        match ctx.runs.id() {
+            None => say(format_args!("SCOUT-STALL cpu{cpu} on its idle context")),
+            Some(id) => say(format_args!("SCOUT-STALL cpu{cpu} on {id} saved depth {}", ctx.preempt)),
+        }
+    }
+}
