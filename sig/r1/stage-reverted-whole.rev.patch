+        self.reset(sig);
+        Some(delivery)
+    }
+
+    /// A handler kept with `SA_RESETHAND` is the default's once it is taken.
+    fn reset(&mut self, sig: i32) {
+        if let Kept::Handle(action) = self.kept(sig) {
+            if action.flags & SA_RESETHAND != 0 {
