cp tree-1g.img tree-1g.r.img && bcachefs fusemount tree-1g.r.img /mnt/t && cd /mnt/t && find . -mindepth 1 | sort | while IFS= read -r p; do if [ -L "$p" ]; then echo "l $(readlink "$p" | tr -d '\n' | sha256sum | cut -d' ' -f1) $p"; elif [ -d "$p" ]; then echo "d $p"; else echo "f $(sha256sum < "$p" | cut -d' ' -f1) $(stat -c %h "$p") $p"; fi; done > /tmp/tree-1g.seen; cd /; fusermount3 -u /mnt/t
