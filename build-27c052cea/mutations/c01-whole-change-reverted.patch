-    assert_eq!(merge.key(Slot::KERNEL, press(A)).collect::<Vec<_>>(), [RawKeyEvent { keycode: A, modifiers: MOD_SHIFT }]);
-    assert_eq!(merge.key(slot(0), lift(SHIFT)).collect::<Vec<_>>(), [RawKeyEvent { keycode: SHIFT, modifiers: MOD_RELEASED }]);
