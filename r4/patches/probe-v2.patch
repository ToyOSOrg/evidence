+/// Diagnostic probe: one I/O's power-state facts.
+#[derive(Clone, Copy, Debug, Default)]
+struct Ev {
+    at_ns: u64,
+    op: u8,
+    /// Since the device last went idle, where it was idle at this arrival.
+    idle_ms: Option<u64>,
+    /// The power state Get Features answered at this arrival.
+    ps: Option<u8>,
+    lat_us: u64,
+}
+
+/// Diagnostic probe: every I/O timed, an idle arrival's power state asked,
+/// and the notable ones logged in batches at least 30 s apart.
+#[derive(Debug)]
+struct Probe {
+    idle_since: Instant,
+    pending: Option<(usize, u16, Ev)>,
+    events: Vec<Ev>,
+    said: Instant,
+}
+
+impl Probe {
+    fn new() -> Self {
+        Self { idle_since: Instant::now(), pending: None, events: Vec::new(), said: Instant::now() }
+    }
+
+    fn completed(&mut self, queue: usize, cid: u16, op: u8, since: Instant) {
+        let lat_us = since.elapsed().as_micros() as u64;
+        let ev = match self.pending.take() {
+            Some((q, c, ev)) if q == queue && c == cid => Ev { lat_us, ..ev },
+            other => {
+                self.pending = other;
+                if lat_us < 2_000 {
+                    return;
+                }
+                let at_ns = toyos_abi::clock::nanos_since_boot().saturating_sub(lat_us * 1000);
+                Ev { at_ns, op, lat_us, ..Ev::default() }
+            }
+        };
+        let notable = ev.lat_us >= 2_000 || ev.idle_ms.is_some_and(|ms| ms >= 50) || ev.ps.is_some_and(|ps| ps != 0);
+        if notable && self.events.len() < 4096 {
+            self.events.push(ev);
+        }
+    }
+
+    fn flush_lines(&mut self) {
+        if self.said.elapsed() < Duration::from_secs(30) || self.events.is_empty() {
+            return;
+        }
+        self.said = Instant::now();
+        for chunk in self.events.chunks(16) {
+            let evs: Vec<String> = chunk
+                .iter()
+                .map(|e| {
+                    let op = match e.op { 0x00 => "flush", 0x01 => "write", 0x02 => "read", _ => "op" };
+                    let idle = e.idle_ms.map_or("busy".to_string(), |ms| format!("idle {ms} ms"));
+                    let ps = e.ps.map_or("-".to_string(), |ps| format!("ps{ps}"));
+                    format!("{}.{:03} {op} {idle} {ps} {} us", e.at_ns / 1_000_000_000, e.at_ns / 1_000_000 % 1000, e.lat_us)
+                })
+                .collect();
+            println!("nvme probe: {}", evs.join("; "));
+        }
+        self.events.clear();
+    }
+}
