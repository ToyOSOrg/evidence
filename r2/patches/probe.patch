+    /// Diagnostic: where no I/O is outstanding, ask the controller its power
+    /// state (Get Features 02h, §5.1.25.1.2). An admin command neither leaves
+    /// a non-operational state nor counts as I/O for APST's idle time
+    /// (§8.1.17.1, §8.1.17.2).
+    fn probe_state(&mut self) {
+        let gap = self.probe.last.elapsed();
+        self.probe.last = Instant::now();
+        if self.busy() != 0 {
+            return;
+        }
+        let cmd = Command { opcode: 0x0A, cdw10: 0x02, ..Command::default() };
+        let ps = match self.admin_command("Get Features (Power Management)", cmd) {
+            Ok(dw0) => (dw0 & 0x1F) as usize,
+            Err(_) => 32,
+        };
+        self.probe.found[ps] += 1;
+        let ms = gap.as_millis() as u64;
+        self.probe.gap_max[ps] = self.probe.gap_max[ps].max(ms);
+        self.probe.gap_min[ps] = self.probe.gap_min[ps].min(ms);
+        if self.probe.said.elapsed() >= Duration::from_secs(30) {
+            self.probe.said = Instant::now();
+            let states: Vec<String> = (0..33)
+                .filter(|&n| self.probe.found[n] != 0)
+                .map(|n| format!("ps{n}={} gap {}..{} ms", self.probe.found[n], self.probe.gap_min[n], self.probe.gap_max[n]))
+                .collect();
+            println!("nvme probe: an idle device's state at each arrival: {}", states.join(", "));
+        }
+    }
+
